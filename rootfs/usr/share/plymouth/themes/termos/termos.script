# termOS boot splash: centred logo, name, rotating spinner, and optional LUKS password prompt.
Window.SetBackgroundTopColor(0.067, 0.067, 0.106);     # #11111b
Window.SetBackgroundBottomColor(0.118, 0.118, 0.180);  # #1e1e2e

sw = Window.GetWidth();
sh = Window.GetHeight();
# scale for small/large panels: logo is 280px wide at 1280px-wide screens
k = Math.Min(sw, sh) / 800;
if (k < 0.6) k = 0.6;
if (k > 2.0) k = 2.0;

logo.image = Image("logo.png");
logo.image = logo.image.Scale(logo.image.GetWidth() * k, logo.image.GetHeight() * k);
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(sw / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(sh / 2 - logo.image.GetHeight() / 2 - 50 * k);

name.image = Image.Text("termOS", 0.804, 0.839, 0.957, 1, "Sans Bold " + Math.Int(30 * k));
name.sprite = Sprite(name.image);
name.sprite.SetX(sw / 2 - name.image.GetWidth() / 2);
name.sprite.SetY(sh / 2 + 110 * k - 50 * k);

spin.base = Image("spinner.png");
spin.base = spin.base.Scale(spin.base.GetWidth() * k * 0.7, spin.base.GetHeight() * k * 0.7);
spin.sprite = Sprite();
spin.sprite.SetX(sw / 2 - spin.base.GetWidth() / 2);
spin.sprite.SetY(sh / 2 + 170 * k - 50 * k);
spin.angle = 0;

prompt.sprite = Sprite();
bullets.sprite = Sprite();
msg.sprite = Sprite();

fun refresh() {
    spin.angle += 0.11;   # radians per frame (~50 fps)
    spin.sprite.SetImage(spin.base.Rotate(spin.angle));
}
Plymouth.SetRefreshFunction(refresh);

fun display_normal_callback() {
    spin.sprite.SetOpacity(1);
    prompt.sprite.SetOpacity(0);
    bullets.sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun display_password_callback(text, count) {
    spin.sprite.SetOpacity(0);
    label = text;
    if (!label || label == "") label = "Enter disk passphrase";
    prompt.image = Image.Text(label, 0.804, 0.839, 0.957, 1, "Sans " + Math.Int(16 * k));
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetX(sw / 2 - prompt.image.GetWidth() / 2);
    prompt.sprite.SetY(sh / 2 + 165 * k - 50 * k);
    prompt.sprite.SetOpacity(1);

    dots = "";
    shown = count;
    if (shown > 32) shown = 32;
    for (i = 0; i < shown; i++) dots += "● ";
    if (dots == "") dots = " ";
    bullets.image = Image.Text(dots, 0.537, 0.706, 0.980, 1, "Sans " + Math.Int(18 * k));
    bullets.sprite.SetImage(bullets.image);
    bullets.sprite.SetX(sw / 2 - bullets.image.GetWidth() / 2);
    bullets.sprite.SetY(sh / 2 + 205 * k - 50 * k);
    bullets.sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun message_callback(text) {
    if (!text || text == "") {
        msg.sprite.SetOpacity(0);
        return;
    }
    msg.image = Image.Text(text, 0.651, 0.678, 0.784, 1, "Sans " + Math.Int(13 * k));
    msg.sprite.SetImage(msg.image);
    msg.sprite.SetX(sw / 2 - msg.image.GetWidth() / 2);
    msg.sprite.SetY(sh / 2 + 245 * k - 50 * k);
    msg.sprite.SetOpacity(1);
}
Plymouth.SetMessageFunction(message_callback);
