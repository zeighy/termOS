#!/usr/bin/env python3
"""termOS Performance Monitor - live CPU, memory, disk, network and battery graphs (GTK3 + cairo)."""
import glob
import os
import re
import sys
from collections import deque

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "termos"))
from termosui import core, palette, ui  # noqa: E402

from gi.repository import GLib, Gtk  # noqa: E402

HISTORY = 60  # seconds shown
COLORS = {"cpu": palette.rgb("accent"), "mem": palette.rgb("green"), "disk": palette.rgb("orange"),
          "net": palette.rgb("mauve"), "bat": palette.rgb("yellow")}
CSS = """
.overview button.metric {{ background-color: {card}; border-radius: 16px; padding: 12px 14px; }}
.overview button.metric:hover {{ background-color: {raised}; }}
.overview flowboxchild {{ padding: 0; }}
.metric-value {{ font-size: 24px; font-weight: bold; color: {bright}; }}
.detail-value {{ font-size: 26px; font-weight: bold; color: {bright}; }}
"""
slurp = core.slurp


def rate(b):
    for unit in ("B/s", "kB/s", "MB/s", "GB/s"):
        if b < 1024 or unit == "GB/s":
            return f"{b:.0f} {unit}" if unit == "B/s" else f"{b:.1f} {unit}"
        b /= 1024


def size(kb):
    return f"{kb / 1024 / 1024:.1f} GB" if kb >= 1024 * 1024 else f"{kb / 1024:.0f} MB"


class Graph(Gtk.DrawingArea):
    """Scrolling line graph. fixed_max=None autoscales (for throughput)."""

    def __init__(self, color, fixed_max=100.0, series=1, height=170, data=None):
        super().__init__()
        self.color = color
        self.fixed_max = fixed_max
        # the overview and the detail page draw the same history
        self.data = data or [deque([0.0] * HISTORY, maxlen=HISTORY) for _ in range(series)]
        self.mirrors = []
        self.set_size_request(-1, height)
        self.set_hexpand(True)
        self.connect("draw", self.on_draw)

    def push(self, *vals):
        for d, v in zip(self.data, vals):
            d.append(v)
        self.queue_draw()
        for other in self.mirrors:
            other.queue_draw()

    def on_draw(self, _w, cr):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        r, g, b = self.color
        cr.set_source_rgba(r, g, b, 0.08)
        cr.rectangle(0, 0, w, h)
        cr.fill()
        cr.set_source_rgba(r, g, b, 0.22)
        cr.set_line_width(1)
        for i in range(1, 4):
            y = round(h * i / 4) + 0.5
            cr.move_to(0, y)
            cr.line_to(w, y)
        cr.stroke()
        top = self.fixed_max or max(1024.0, max(max(d) for d in self.data) * 1.15)
        for n, d in enumerate(self.data):
            pts = [(w * i / (HISTORY - 1), h - min(v / top, 1.0) * (h - 2) - 1) for i, v in enumerate(d)]
            alpha = 1.0 if n == 0 else 0.6
            cr.move_to(*pts[0])
            for p in pts[1:]:
                cr.line_to(*p)
            cr.set_source_rgba(r, g, b, alpha)
            cr.set_line_width(2.5)
            cr.stroke_preserve()
            if n == 0:
                cr.line_to(w, h)
                cr.line_to(0, h)
                cr.close_path()
                cr.set_source_rgba(r, g, b, 0.18)
                cr.fill()
        if not self.fixed_max:
            cr.set_source_rgba(1, 1, 1, 0.45)
            cr.set_font_size(11)
            cr.move_to(6, 14)
            cr.show_text(rate(top))
        return False


class Cores(Gtk.DrawingArea):
    """One thin bar per CPU core."""

    def __init__(self, n):
        super().__init__()
        self.n = n
        self.vals = [0.0] * n
        self.set_size_request(-1, 26 * ((n + 1) // 2) + 6)
        self.connect("draw", self.on_draw)

    def on_draw(self, _w, cr):
        w = self.get_allocated_width()
        cols = 2 if self.n > 1 else 1
        cw = (w - 12 * (cols - 1)) / cols
        r, g, b = COLORS["cpu"]
        for i, v in enumerate(self.vals):
            x = (i % cols) * (cw + 12)
            y = (i // cols) * 26 + 3
            cr.set_source_rgba(r, g, b, 0.15)
            cr.rectangle(x, y, cw, 18)
            cr.fill()
            cr.set_source_rgba(r, g, b, 0.9)
            cr.rectangle(x, y, cw * v / 100, 18)
            cr.fill()
            cr.set_source_rgba(1, 1, 1, 0.85)
            cr.set_font_size(11)
            cr.move_to(x + 6, y + 13)
            cr.show_text(f"core {i}   {v:.0f}%")
        return False


class Metric:
    """An overview card and the detail page behind it."""

    def __init__(self, win, key, icon, title, fixed_max=100.0, series=1, note=None):
        self.value = ui.label("–", "detail-value", wrap=True)
        self.sub = ui.label("", "sub", wrap=True)
        self.graph = Graph(COLORS[key], fixed_max, series)

        self.page = ui.Page(820)
        head = ui.hbox(8)
        head.pack_start(ui.button(None, win.show_overview, "flat", "round", icon_name="back", tip="Back"),
                        False, False, 0)
        head.pack_start(ui.label(title, "title"), True, True, 0)
        self.page.box.pack_start(head, False, False, 0)
        self.page.section()
        for w in (self.value, self.graph, self.sub):
            self.page.add(w)
        if note:
            self.page.note(note)
        win.stack.add_named(self.page.widget, key)

        self.small_value = ui.label("–", "metric-value", ellipsize=True)
        small = Graph(COLORS[key], fixed_max, series, 62, self.graph.data)
        self.graph.mirrors.append(small)
        button = ui.classes(Gtk.Button(), "metric")
        box = ui.vbox(6)
        line = ui.hbox(8)
        line.pack_start(ui.icon(icon), False, False, 0)
        line.pack_start(ui.label(title, "heading"), True, True, 0)
        line.pack_end(ui.icon("right", "sub"), False, False, 0)
        for w in (line, self.small_value, small):
            box.pack_start(w, False, False, 0)
        button.add(box)
        button.set_size_request(250, -1)
        button.get_accessible().set_name(title)
        button.connect("clicked", lambda _b: win.stack.set_visible_child_name(key))
        child = Gtk.FlowBoxChild()
        child.set_can_focus(False)
        child.add(button)
        win.flow.add(child)

    def set_value(self, text, short=None):
        self.value.set_text(text)
        self.small_value.set_text(short or text)


class PerfMon(Gtk.ApplicationWindow):
    def __init__(self):
        super().__init__(title="Performance Monitor")
        ui.css(CSS)
        self.set_default_size(900, 640)
        self.set_icon_name("org.gnome.SystemMonitor")
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_hhomogeneous(False)
        self.add(self.stack)

        overview = ui.vbox(12, "overview")
        overview.set_border_width(16)
        overview.pack_start(ui.label("Performance", "title"), False, False, 0)
        self.flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                                column_spacing=10, row_spacing=10)
        self.flow.set_max_children_per_line(3)
        overview.pack_start(self.flow, False, False, 0)
        self.footer = ui.label("", "sub", wrap=True)
        overview.pack_start(self.footer, False, False, 4)
        self.stack.add_named(ui.scrolled(ui.Clamp(overview, 1120)), "overview")

        self.ncpu = os.cpu_count() or 1
        self.prev_cpu = None
        self.prev_disk = None
        self.prev_net = None
        model = re.search(r"model name\s*:\s*(.*)", slurp("/proc/cpuinfo"))
        self.cpu_model = re.sub(r"\s+", " ", model.group(1)) if model else "CPU"
        self.footer.set_text(self.cpu_model)

        self.cpu = Metric(self, "cpu", "cpu", "CPU")
        self.cores = Cores(self.ncpu)
        self.cpu.page.section("Each core")
        self.cpu.page.add(self.cores)
        self.cpu.page.note(self.cpu_model)

        self.mem = Metric(self, "mem", "memory", "Memory")
        self.mem.page.section("Swap (compressed in RAM)")
        self.swap_graph = Graph(COLORS["mem"], height=120)
        self.swap_val = ui.label("", "sub", wrap=True)
        self.mem.page.add(self.swap_graph)
        self.mem.page.add(self.swap_val)

        self.disk = Metric(self, "disk", "disk", "Disk", None, 2, "The lighter line is writes.")
        self.net = Metric(self, "net", "swap", "Network", None, 2, "The lighter line is upload.")
        info = core.battery()
        self.bat = info["path"] if info else None
        if self.bat:
            self.battery = Metric(self, "bat", "battery", "Battery")

        self.last = GLib.get_monotonic_time()
        self.tick()
        # rates need two samples, so take the second one quickly
        GLib.timeout_add(400, lambda: (self.tick(), False)[1])
        ui.every(self, 1, self.tick)
        self.connect("key-press-event", self.key)

    def show_overview(self):
        self.stack.set_visible_child_name("overview")

    def key(self, _w, event):
        if event.keyval == 0xff1b:      # Esc
            self.show_overview()
            return True
        return False

    # ---- sampling --------------------------------------------------------
    def tick(self):
        now = GLib.get_monotonic_time()
        dt = max((now - self.last) / 1e6, 0.1)
        self.last = now
        self.sample_cpu()
        self.sample_mem()
        self.sample_disk(dt)
        self.sample_net(dt)
        if self.bat:
            self.sample_bat()
        return True

    def sample_cpu(self):
        cur = []
        for line in slurp("/proc/stat").splitlines():
            if line.startswith("cpu"):
                f = line.split()
                v = [int(x) for x in f[1:9]]
                cur.append((sum(v), v[3] + v[4]))  # total, idle+iowait
        if self.prev_cpu and len(cur) == len(self.prev_cpu):
            pct = []
            for (t, i), (pt, pi) in zip(cur, self.prev_cpu):
                dt_ = max(t - pt, 1)
                pct.append(100.0 * (1 - (i - pi) / dt_))
            total, per = pct[0], pct[1:]
            self.cpu.graph.push(total)
            self.cpu.set_value(f"{total:.0f}%")
            if len(per) == self.ncpu:
                self.cores.vals = per
                self.cores.queue_draw()
            freqs = []
            for p in glob.glob("/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq"):
                try:
                    freqs.append(int(slurp(p)) / 1000)
                except ValueError:
                    pass
            parts = [f"load {' '.join(slurp('/proc/loadavg').split()[:3])}"]
            if freqs:
                parts.append(f"speed {sum(freqs) / len(freqs) / 1000:.2f} GHz")
            temp = self.temperature()
            if temp:
                parts.append(f"{temp:.0f} °C")
            self.cpu.sub.set_text("   ·   ".join(parts) + f"   ·   {self.ncpu} threads")
        self.prev_cpu = cur

    @staticmethod
    def temperature():
        best = 0.0
        for z in glob.glob("/sys/class/thermal/thermal_zone*/temp"):
            try:
                best = max(best, int(slurp(z)) / 1000)
            except ValueError:
                pass
        return best

    def sample_mem(self):
        m = {}
        for line in slurp("/proc/meminfo").splitlines():
            k, _, v = line.partition(":")
            m[k] = int(v.split()[0]) if v.split() else 0
        tot = m.get("MemTotal", 1)
        used = tot - m.get("MemAvailable", 0)
        self.mem.graph.push(100.0 * used / tot)
        self.mem.set_value(f"{100.0 * used / tot:.0f}%",
                           f"{100.0 * used / tot:.0f}%  ·  {size(used)}")
        self.mem.sub.set_text(f"{size(used)} used of {size(tot)}   ·   cached {size(m.get('Cached', 0))}"
                              f"   ·   available {size(m.get('MemAvailable', 0))}")
        st, sf = m.get("SwapTotal", 0), m.get("SwapFree", 0)
        if st:
            self.swap_graph.push(100.0 * (st - sf) / st)
            self.swap_val.set_text(f"{size(st - sf)} used of {size(st)}")
        else:
            self.swap_graph.push(0)
            self.swap_val.set_text("no swap")

    def sample_disk(self, dt):
        rd = wr = 0
        for line in slurp("/proc/diskstats").splitlines():
            f = line.split()
            if len(f) > 9 and re.fullmatch(r"(sd[a-z]+|vd[a-z]+|nvme\d+n\d+|mmcblk\d+)", f[2]):
                rd += int(f[5]) * 512
                wr += int(f[9]) * 512
        if self.prev_disk:
            r, w = max(rd - self.prev_disk[0], 0) / dt, max(wr - self.prev_disk[1], 0) / dt
            self.disk.graph.push(r, w)
            self.disk.set_value(f"read {rate(r)}   write {rate(w)}", rate(r + w))
            st = os.statvfs("/")
            tot = st.f_blocks * st.f_frsize
            free = st.f_bavail * st.f_frsize
            self.disk.sub.set_text(f"{(tot - free) / 1e9:.1f} GB used of {tot / 1e9:.1f} GB")
        self.prev_disk = (rd, wr)

    def sample_net(self, dt):
        rx = tx = 0
        for line in slurp("/proc/net/dev").splitlines()[2:]:
            name, _, rest = line.partition(":")
            if name.strip() == "lo":
                continue
            f = rest.split()
            rx += int(f[0])
            tx += int(f[8])
        if self.prev_net:
            d, u = max(rx - self.prev_net[0], 0) / dt, max(tx - self.prev_net[1], 0) / dt
            self.net.graph.push(d, u)
            self.net.set_value(f"↓ {rate(d)}   ↑ {rate(u)}", f"↓ {rate(d)}")
            self.net.sub.set_text(f"received {rx / 1e6:.0f} MB   ·   sent {tx / 1e6:.0f} MB since boot")
        self.prev_net = (rx, tx)

    def sample_bat(self):
        info = core.battery()
        if not info:
            return
        cap, status = info["percent"], info["status"]
        self.battery.graph.push(float(cap))
        self.battery.set_value(f"{cap}%   {status}", f"{cap}%")
        parts = []
        if info["watts"] is not None:
            parts.append(f"{info['watts']:.1f} W")
        if info["health"] is not None:
            parts.append(f"health {info['health']}%")
        m = re.search(r"^ACTIVE=(\S+)", slurp("/etc/termos/power.conf"), re.M)
        if m:
            parts.append(f"power mode: {m.group(1)}")
        self.battery.sub.set_text("   ·   ".join(p for p in parts if p))


if __name__ == "__main__":
    sys.exit(ui.main("Performance", PerfMon, "termos-perfmon"))
