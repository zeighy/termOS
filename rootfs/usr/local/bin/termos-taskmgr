#!/usr/bin/env python3
"""termOS Task Manager - see what is running and end it (GTK3, reads /proc)."""
import os
import pwd
import signal
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "termos"))
from termosui import apps, core, ui  # noqa: E402

from gi.repository import Gio, GLib, Gtk, Pango  # noqa: E402

TICK = os.sysconf("SC_CLK_TCK")
PAGE_KB = os.sysconf("SC_PAGE_SIZE") // 1024
ME = os.getuid()
C_ICON, C_NAME, C_CPU, C_MEM, C_KEY = range(5)
# programs without a desktop entry, or whose process name doesn't match it
FRIENDLY = {
    "termos-shell": "Desktop shell", "termos-lock": "Lock screen", "termos-session-watch": "Lock service",
    "termos-updater": "Update termOS", "termos-welcome": "Welcome", "termos-connect": "SSH connection",
    "termos-battery-monitor": "Battery monitor", "squeekboard": "On-screen keyboard",
    "labwc": "Window manager", "mako": "Notifications", "swaybg": "Wallpaper", "swayidle": "Idle timer",
    "pipewire": "Sound", "pipewire-pulse": "Sound", "wireplumber": "Sound", "bash": "Shell (bash)",
}
HELPERS = ("glycin", "bwrap", "dbus-", "chrome_crashpad")
NOT_APPS = {"termos-show", "termos-osk", "termos-screenshot", "termos-apps"}
CSS = """
.tasks treeview.view {{ background-color: {card}; font-size: 15px; }}
.tasks treeview.view:selected {{ background-color: {raised}; color: {bright}; }}
.tasks treeview header button {{ min-height: 40px; border-radius: 0; background-color: {mantle}; }}
"""


def human(kb):
    if kb >= 1024 * 1024:
        return f"{kb / 1024 / 1024:.1f} GB"
    if kb >= 1024:
        return f"{kb / 1024:.0f} MB"
    return f"{kb} kB"


def username(uid, cache={}):
    if uid not in cache:
        try:
            cache[uid] = pwd.getpwuid(uid).pw_name
        except KeyError:
            cache[uid] = str(uid)
    return cache[uid]


def program_name(comm, argv):
    """The script's name for interpreters, otherwise the program's."""
    if comm.startswith("python") or comm in ("bash", "sh"):
        for arg in argv[1:3]:
            if arg.startswith("/") and not arg.startswith("-"):
                return os.path.basename(arg)
        return comm
    # comm is cut at 15 characters
    if len(comm) == 15 and argv:
        base = os.path.basename(argv[0].split(" ")[0])
        if base.startswith(comm):
            return base
    return comm


def read_procs():
    procs = {}
    for ent in os.listdir("/proc"):
        if not ent.isdigit():
            continue
        try:
            with open(f"/proc/{ent}/stat", encoding="utf-8", errors="replace") as f:
                raw = f.read()
            # comm is in parentheses and may contain spaces/parens
            lp, rp = raw.index("("), raw.rindex(")")
            rest = raw[rp + 2:].split()
            uid = os.stat(f"/proc/{ent}").st_uid
            with open(f"/proc/{ent}/cmdline", "rb") as f:
                argv = [a for a in f.read().decode(errors="replace").split("\0") if a]
            with open(f"/proc/{ent}/statm", encoding="ascii") as f:
                statm = f.read().split()
        except (OSError, ValueError, IndexError):
            continue
        rss, shared = int(statm[1]), int(statm[2])
        if not argv and not rss:
            continue        # kernel thread
        comm = raw[lp + 1:rp]
        procs[int(ent)] = {
            "pid": int(ent), "ppid": int(rest[1]), "uid": uid, "started": rest[19],
            "jiffies": int(rest[11]) + int(rest[12]),
            # private memory, so programs with many processes aren't counted several times over
            "mem": max(rss - shared, 0) * PAGE_KB,
            "cmd": " ".join(argv), "name": program_name(comm, argv),
        }
    return procs


def app_index():
    index = {}
    for app in apps.installed():
        exe = os.path.basename(app.get_executable() or "")
        # entries like "foot -e something" would claim every terminal
        command = (app.get_commandline() or "").split()
        if exe and exe not in NOT_APPS and not (exe == "foot" and "-e" in command):
            index.setdefault(exe.lower(), app)
    return index


class TaskManager(Gtk.ApplicationWindow):
    def __init__(self):
        super().__init__(title="Task Manager")
        ui.css(CSS)
        self.set_default_size(900, 640)
        self.set_icon_name("utilities-system-monitor")
        self.view = "apps"
        self.sort = "cpu"
        self.prev = {}
        self.prev_at = time.monotonic()
        self.items = {}
        self.touched = 0
        self.index = app_index()

        outer = ui.vbox(10, "tasks")
        outer.set_border_width(12)
        self.add(outer)

        top = ui.hbox(8)
        self.tabs = {}
        for key, text in (("apps", "Apps"), ("all", "Processes")):
            b = ui.button(text, lambda k=key: self.set_view(k))
            self.tabs[key] = b
            top.pack_start(b, False, False, 0)
        self.search = Gtk.SearchEntry(placeholder_text="Search")
        self.search.set_width_chars(6)
        self.search.connect("search-changed", lambda _e: self.render(True))
        top.pack_start(self.search, True, True, 0)
        outer.pack_start(top, False, False, 0)
        self.summary = ui.label("", "sub", wrap=True)
        outer.pack_start(self.summary, False, False, 0)

        self.store = Gtk.ListStore(Gio.Icon, str, str, str, str)
        self.tree = Gtk.TreeView(model=self.store)
        self.tree.set_enable_search(False)
        self.columns = {}

        name_col = Gtk.TreeViewColumn("Name")
        pix = Gtk.CellRendererPixbuf(xpad=8, stock_size=Gtk.IconSize.DND)
        name_col.pack_start(pix, False)
        name_col.add_attribute(pix, "gicon", C_ICON)
        text = Gtk.CellRendererText(ellipsize=Pango.EllipsizeMode.END, ypad=9)
        name_col.pack_start(text, True)
        name_col.add_attribute(text, "markup", C_NAME)
        name_col.set_expand(True)
        self.add_column("name", name_col)
        for key, title, col_idx, width in (("cpu", "CPU", C_CPU, 76), ("mem", "Memory", C_MEM, 100)):
            cell = Gtk.CellRendererText(xalign=1.0, xpad=10)
            col = Gtk.TreeViewColumn(title, cell, text=col_idx)
            col.set_min_width(width)
            col.set_alignment(1.0)
            self.add_column(key, col)
        # don't move rows from under a finger
        for event in ("button-press-event", "touch-event", "scroll-event"):
            self.tree.connect(event, self.touch)
        self.tree.get_selection().connect("changed", self.selection_changed)
        sw = ui.scrolled(self.tree)
        sw.connect("scroll-event", self.touch)
        outer.pack_start(sw, True, True, 0)

        self.hint = ui.label("", "sub", wrap=True)
        outer.pack_start(self.hint, False, False, 0)
        bottom = ui.hbox(8)
        self.end_btn = ui.button("End task", lambda: self.kill(signal.SIGTERM))
        self.force_btn = ui.button("Force quit", lambda: self.kill(signal.SIGKILL), "danger")
        bottom.pack_start(self.end_btn, False, False, 0)
        bottom.pack_start(self.force_btn, False, False, 0)
        self.clear_btn = ui.button("Deselect", lambda: self.tree.get_selection().unselect_all(), "flat")
        bottom.pack_end(self.clear_btn, False, False, 0)
        outer.pack_start(bottom, False, False, 0)

        self.refresh()
        self.tree.get_selection().unselect_all()
        self.selection_changed()
        self.set_view("apps")
        self.connect("map", lambda _w: GLib.idle_add(
            lambda: (self.tree.get_selection().unselect_all(), False)[1]))
        GLib.timeout_add(700, lambda: (self.refresh(), False)[1])
        ui.every(self, 2, self.refresh)

    def add_column(self, key, col):
        col.set_clickable(True)
        col.connect("clicked", lambda _c: self.set_sort(key))
        self.tree.append_column(col)
        self.columns[key] = col

    def touch(self, *_a):
        self.touched = time.monotonic()
        return False

    def held(self):
        selected = self.tree.get_selection().get_selected()[1] is not None
        return selected or time.monotonic() - self.touched < 4

    def selection_changed(self, *_a):
        has = self.selected() is not None
        for b in (self.end_btn, self.force_btn, self.clear_btn):
            b.set_sensitive(has)
        self.hint.set_text("The order stays put while something is selected." if has
                           else "Tap a row to end it.")

    def set_sort(self, key):
        self.sort = key
        for k, col in self.columns.items():
            col.set_sort_indicator(k == key)
            col.set_sort_order(Gtk.SortType.ASCENDING if k == "name" else Gtk.SortType.DESCENDING)
        self.render(True)

    def set_view(self, view):
        self.view = view
        for key, b in self.tabs.items():
            ui.set_class(b, "primary", key == view)
        self.tree.get_selection().unselect_all()
        self.build_items()
        self.set_sort(self.sort)

    def refresh(self):
        procs = read_procs()
        now = time.monotonic()
        span = max(now - self.prev_at, 0.05)
        for pid, p in procs.items():
            before = self.prev.get(pid)
            p["cpu"] = 0.0
            if before and before[1] == p["started"]:
                # percent of ONE core, like top: 100% = one core fully busy
                p["cpu"] = max(p["jiffies"] - before[0], 0) / TICK / span * 100
        self.prev = {pid: (p["jiffies"], p["started"]) for pid, p in procs.items()}
        self.prev_at = now
        self.procs = procs
        self.build_items()

        mem = {}
        for line in core.slurp("/proc/meminfo").splitlines():
            key, _, value = line.partition(":")
            if value.split():
                mem[key] = int(value.split()[0])
        used = mem.get("MemTotal", 0) - mem.get("MemAvailable", 0)
        load = " ".join(core.slurp("/proc/loadavg").split()[:3])
        self.summary.set_text(f"Memory {human(used)} of {human(mem.get('MemTotal', 0))}   ·   "
                              f"load {load}   ·   {len(procs)} processes")

    def app_of(self, proc):
        return self.index.get(proc["name"].lower()) if proc["uid"] == ME else None

    def build_items(self):
        procs = self.procs
        items = {}
        if self.view == "all":
            for pid, p in procs.items():
                items[f"p{pid}"] = {
                    "title": FRIENDLY.get(p["name"], p["name"]),
                    "detail": f"{username(p['uid'])}  ·  {pid}  ·  {p['cmd'][:120]}",
                    "icon": None, "cpu": p["cpu"], "mem": p["mem"], "members": [p],
                    "search": f"{pid} {p['name']} {p['cmd']}",
                }
        else:
            kids = {}
            for pid, p in procs.items():
                kids.setdefault(p["ppid"], []).append(pid)
            for pid, p in procs.items():
                app = self.app_of(p)
                if not app:
                    continue
                parent = procs.get(p["ppid"])
                if parent and self.app_of(parent) is app:
                    continue    # a helper process of the same app
                members, todo = [], [pid]
                while todo:
                    cur = todo.pop()
                    other = self.app_of(procs[cur])
                    if cur != pid and other and other is not app:
                        continue        # an app started from this one is its own row
                    members.append(procs[cur])
                    todo += kids.get(cur, [])
                inner = sorted({m["name"] for m in members[1:]
                                if m["name"] != p["name"] and not m["name"].startswith(HELPERS)})
                detail = "Running " + ", ".join(inner) if inner else app.get_description() or ""
                items[f"a{pid}"] = {
                    "title": app.get_display_name(), "detail": detail, "icon": app.get_icon(),
                    "cpu": sum(m["cpu"] for m in members), "mem": sum(m["mem"] for m in members),
                    "members": members,
                    "search": " ".join([app.get_display_name()] + [m["name"] for m in members]),
                }
        self.items = items
        self.render()

    def render(self, force=False):
        query = self.search.get_text().strip().lower()
        shown = {k: v for k, v in self.items.items() if not query or query in v["search"].lower()}

        def values(key):
            item = shown[key]
            title, detail = (GLib.markup_escape_text(item[x]) for x in ("title", "detail"))
            markup = title + (f"\n<small><span alpha='65%'>{detail}</span></small>" if detail else "")
            return [item["icon"], markup, f"{item['cpu']:.0f}%", human(item["mem"]), key]

        rows = {}
        for row in list(self.store):
            key = row[C_KEY]
            if key in shown:
                new = values(key)
                for idx in (C_NAME, C_CPU, C_MEM):
                    if row[idx] != new[idx]:
                        row[idx] = new[idx]
                rows[key] = row.iter
            else:
                self.store.remove(row.iter)
        for key in shown:
            if key not in rows:
                self.store.append(values(key))
        if len(self.store) < 2 or (not force and self.held()):
            return
        sort_key = {"cpu": lambda i: (-i["cpu"], -i["mem"]), "mem": lambda i: (-i["mem"],),
                    "name": lambda i: (i["title"].lower(),)}[self.sort]
        order = [row[C_KEY] for row in self.store]
        wanted = sorted(order, key=lambda k: sort_key(shown[k]))
        if wanted != order:
            where = {k: i for i, k in enumerate(order)}
            self.store.reorder([where[k] for k in wanted])

    def selected(self):
        model, it = self.tree.get_selection().get_selected()
        return self.items.get(model[it][C_KEY]) if it else None

    def kill(self, sig):
        item = self.selected()
        if not item:
            return
        members = list(item["members"])
        if members[0]["pid"] in (1, os.getpid()):
            ui.message(self, "That one can't be ended from here.")
            return
        force = sig == signal.SIGKILL
        if not ui.confirm(self, f"{'Force quit' if force else 'End'} {item['title']}?",
                          "Unsaved work in it will be lost." if force else "It gets a chance to close cleanly.",
                          "Force quit" if force else "End task", danger=force):
            return
        # a polite end goes to the main process; force quit takes the helpers too
        for proc in members if force else members[:1]:
            try:
                with open(f"/proc/{proc['pid']}/stat", encoding="utf-8", errors="replace") as f:
                    raw = f.read()
                if raw[raw.rindex(")") + 2:].split()[19] != proc["started"]:
                    continue        # that process ended and the number was reused
                os.kill(proc["pid"], sig)
            except PermissionError:
                ui.message(self, f"Not allowed to stop {proc['name']}.",
                           f"It belongs to {username(proc['uid'])}.")
                break
            except (OSError, ValueError):
                pass
        self.tree.get_selection().unselect_all()
        GLib.timeout_add(500, lambda: (self.refresh(), False)[1])


if __name__ == "__main__":
    sys.exit(ui.main("TaskManager", TaskManager, "termos-taskmgr"))
