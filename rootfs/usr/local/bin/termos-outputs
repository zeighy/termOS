#!/usr/bin/env python3
"""termOS: resolution and scale for every screen (built-in or external).

  termos-outputs apply    apply saved choices; screens without one get a scale
                          that suits their size (about 150 % on 10" full-HD tablets)

~/.config/termos/outputs.conf lines:  <output> <mode|auto> <scale|auto>
  HDMI-A-1 1920x1080@60.000Hz 1.25
  eDP-1    auto               auto
"""
import math
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "termos"))
from termosui import core, screens  # noqa: E402


def apply():
    saved = screens.read_saved()
    legacy = core.read_conf(core.DISPLAY_CONF)      # older termOS kept the panel's scale here
    for out in screens.connected():
        name = out["name"]
        mode, scale = saved.get(name, ("auto", "auto"))
        if scale == "auto" and name == legacy.get("PANEL") and legacy.get("SCALE"):
            scale = legacy["SCALE"]
        args = []
        if mode != "auto" and mode != screens.current_mode(out):
            args += ["--mode", mode]
        try:
            want = screens.auto_scale(out) if scale == "auto" else float(scale)
        except ValueError:
            want = screens.auto_scale(out)
        if not math.isclose(want, float(out.get("scale", 1)), abs_tol=0.01):
            args += ["--scale", f"{want:g}"]
        if args:
            r = core.run("wlr-randr", "--output", name, *args)
            if r.returncode:
                print(f"termos-outputs: {name}: {r.stderr.strip()}", file=sys.stderr)


if __name__ == "__main__":
    if sys.argv[1:] not in ([], ["apply"]):
        sys.exit("usage: termos-outputs apply")
    apply()
