#!/bin/bash
# termOS volume keys.   termos-volume up|down|mute
sink=@DEFAULT_SINK@
case "${1:-}" in
    mute) pactl set-sink-mute "$sink" toggle ;;
    down) pactl set-sink-mute "$sink" 0; pactl set-sink-volume "$sink" -5% ;;
    up)
        pactl set-sink-mute "$sink" 0
        cur=$(pactl get-sink-volume "$sink" | grep -o '[0-9]\+%' | head -n1 | tr -d %)
        if [ "${cur:-0}" -ge 95 ]; then pactl set-sink-volume "$sink" 100%
        else pactl set-sink-volume "$sink" +5%; fi ;;
    *) sed -n '2p' "$0" >&2; exit 1 ;;
esac
termos-show volume 2>/dev/null
exit 0
