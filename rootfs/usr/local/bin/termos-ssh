#!/usr/bin/env python3
"""termOS SSH Hosts: one-tap connections, and adding hosts without editing files.

  termos-ssh [add | edit NAME]
"""
import glob
import os
import re
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "termos"))
from termosui import core, hosts, seckeys, ui  # noqa: E402

from gi.repository import Gdk, Gtk  # noqa: E402

CSS = """
.host-card {{ background-color: {card}; border-radius: 16px; padding: 4px; }}
.host-card button.connect {{ background-color: transparent; padding: 8px 10px; }}
.host-card .name {{ font-size: 18px; font-weight: bold; }}
.host-card .icon.big {{ font-size: 28px; }}
.dot {{ font-size: 15px; }}
"""
TEMPLATE = """# SSH hosts - each "Host" entry appears in termOS "SSH Hosts" and on the home screen.
# Example (remove the # signs):
#
# Host myserver
#     HostName 192.168.1.10
#     User me
#     Port 2222
"""


OPENPGP_LIST = 'SSH_AUTH_SOCK="$(gpgconf --list-dirs agent-ssh-socket)" ssh-add -L'
PIV_LIST = 'gpgconf --kill scdaemon; ssh-keygen -D "$%d" | grep -v "Attestation"'
SHOW_CARD = f'if [ "$1" = card:piv ]; then {PIV_LIST % 2}; else {OPENPGP_LIST}; fi'
# ssh-copy-id takes a file, and -f because a card has no private key file
COPY_CARD = (f't=$(mktemp -d); if [ "$1" = card:piv ]; then {PIV_LIST % 3}; else {OPENPGP_LIST}; fi'
             ' | grep -E "^(ssh|ecdsa|sk)-" | head -n1 > "$t/card.pub"; '
             'if [ -s "$t/card.pub" ]; then ssh-copy-id -f -i "$t/card.pub" -- "$2"; '
             'else echo "No SSH key was found on the card. Is it plugged in?"; fi; rm -rf "$t"')


def key_files():
    found = []
    for pub in sorted(glob.glob(os.path.join(hosts.SSH_DIR, "*.pub"))):
        if os.path.exists(pub[:-4]):
            found.append("~" + pub[:-4][len(core.HOME):])
    return found


def in_terminal(title, script, *args):
    core.spawn("foot", "-T", title, "-e", "bash", "-c",
               script + "; echo; read -rp 'Press Enter to close. '", "termos", *args)


class Window(Gtk.ApplicationWindow):
    def __init__(self):
        super().__init__(title="SSH Hosts")
        ui.css(CSS)
        self.set_default_size(720, 640)
        self.set_icon_name("network-server")
        self.hosts = []
        self.online = {}
        self.drawn = None
        self.editing = None
        self.alive = True
        self.connect("destroy", self.gone)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_hhomogeneous(False)
        self.stack.add_named(self.list_page(), "list")
        self.form_holder = ui.vbox()
        self.stack.add_named(self.form_holder, "form")
        self.add(self.stack)
        self.connect("notify::is-active", self.activated)
        ui.every(self, 4, self.draw)
        self.reload()
        self.probe()
        ui.every(self, 60, lambda: self.is_active() and self.probe())

    def gone(self, _w):
        self.alive = False

    def activated(self, *_a):
        if not self.is_active():
            return
        self.reload()
        if self.stack.get_visible_child_name() == "form":
            # a key may have just been created in another window
            self.fill_key_choices(self.key_combo.get_active_id() or "")

    def fill_key_choices(self, chosen):
        keys = key_files()
        choices = [("", "Default")]
        for k in keys:
            mark = " (security key)" if seckeys.is_security_key_file(k) else ""
            choices.append((k, os.path.basename(k) + mark))
        choices += [(hosts.PIV, "Smart card (PIV)"), (hosts.OPENPGP, "Smart card (OpenPGP)")]
        if chosen not in dict(choices):
            choices.append((chosen, os.path.basename(chosen)))
        self.key_combo.remove_all()
        for value, text in choices:
            self.key_combo.append(value, text)
        self.key_combo.set_active_id(chosen)

    def open_arg(self, action, name=None, *_rest):
        self.show_all()
        if action == "add":
            self.show_form(None)
        elif action == "edit":
            host = next((h for h in self.hosts if h["name"] == name), None)
            if host and host["editable"]:
                self.show_form(host)

    # ---- list ------------------------------------------------------------
    def list_page(self):
        box = ui.vbox(10)
        box.set_border_width(16)
        head = ui.hbox(8)
        head.pack_start(ui.label("SSH Hosts", "title", ellipsize=True), True, True, 0)
        head.pack_end(ui.button("Add host", lambda: self.show_form(None), "primary", icon_name="plus"),
                      False, False, 0)
        box.pack_start(head, False, False, 0)

        quick = ui.hbox(8)
        self.quick = Gtk.Entry(placeholder_text="user@host or user@host:port")
        self.quick.set_width_chars(8)
        self.quick.connect("activate", lambda _e: self.quick_connect())
        quick.pack_start(self.quick, True, True, 0)
        quick.pack_start(ui.button("Connect", self.quick_connect), False, False, 0)
        box.pack_start(quick, False, False, 0)
        self.quick_error = ui.label("", "error", wrap=True)
        self.quick_error.set_no_show_all(True)
        box.pack_start(self.quick_error, False, False, 0)

        self.cards = ui.vbox(8)
        box.pack_start(self.cards, False, False, 4)
        box.pack_start(ui.button("Edit ~/.ssh/config as text", self.edit_file, "flat", icon_name="edit"),
                       False, False, 0)
        return ui.scrolled(ui.Clamp(box, 760))

    def reload(self):
        self.hosts = hosts.ssh_hosts()
        self.draw()

    def probe(self):
        items = list(self.hosts)

        def done(result):
            if self.alive:
                self.online = result or {}
                self.draw()
        ui.background(lambda: hosts.probe(items), done)

    def draw(self):
        meta, live = hosts.all_meta(), hosts.connections()
        shape = []
        for h in self.hosts:
            opts = hosts.options(h["name"], meta)
            key = hosts.machine_key(h)
            state = live.get(h["name"])
            if state == "connected":
                word = ("Connected", "good")
            elif state == "reconnecting":
                word = ("Reconnecting", "warn")
            elif self.online.get(key) is True:
                word = ("Online", "good")
            elif self.online.get(key) is False:
                word = ("Offline", "error")
            else:
                word = ("", None)
            shape.append((h, opts, word, hosts.ago(opts["used"])))
        if shape == self.drawn:
            return
        self.drawn = shape
        ui.clear(self.cards)
        for item in shape:
            self.cards.pack_start(self.card(*item), False, False, 0)
        if not shape:
            self.cards.pack_start(ui.empty_state(
                "server", "No hosts yet",
                "Add a machine once and it's one tap from here and from the home screen.",
                ui.button("Add your first host", lambda: self.show_form(None), "primary")), False, False, 0)
        self.cards.show_all()

    def card(self, host, opts, word, used):
        line = ui.hbox(4, "host-card")
        b = ui.classes(Gtk.Button(), "connect")
        inner = ui.hbox(14)
        inner.pack_start(ui.icon("server", "big", "accent"), False, False, 0)
        words = ui.vbox(3)
        words.pack_start(ui.label(host["name"], "name", ellipsize=True), False, False, 0)
        addr = (host["user"] + "@" if host["user"] else "") + host["host"]
        if host["port"] and host["port"] != "22":
            addr += ":" + host["port"]
        words.pack_start(ui.label(addr, "sub", ellipsize=True), False, False, 0)
        state = ui.hbox(6)
        if word[0]:
            state.pack_start(ui.label("●", "dot", word[1]), False, False, 0)
        bits = [word[0], used, "resumes tmux" if opts["tmux"] else "", "mosh" if opts["mosh"] else ""]
        state.pack_start(ui.label("  ·  ".join(x for x in bits if x), "sub", ellipsize=True), False, False, 0)
        words.pack_start(state, False, False, 0)
        inner.pack_start(words, True, True, 0)
        b.add(inner)
        b.get_accessible().set_name(f"Connect to {host['name']}")
        b.connect("clicked", lambda _b: hosts.connect(host))
        line.pack_start(b, True, True, 0)
        line.pack_start(ui.button(None, lambda: self.show_form(host), "flat", "round",
                                  icon_name="edit", tip=f"Edit {host['name']}"), False, False, 0)
        return line

    def quick_connect(self):
        text = self.quick.get_text().strip()
        if text.startswith("ssh "):
            text = text[4:].strip()
        target, port = text, ""
        # a colon is a port only when it can't be part of a bare IPv6 address
        m = re.fullmatch(r"((?:[^@]*@)?(?:[^:@\[\]]+|\[[^\]]+\])):(\d{1,5})", text)
        if m:
            target, port = m.groups()
        target = re.sub(r"\[([^\]]+)\]", r"\1", target)
        ok = hosts.TARGET_RE.fullmatch(target) and (not port or 0 < int(port) < 65536)
        self.quick_error.set_visible(not ok)
        if ok:
            hosts.connect_ssh(target, port)
        else:
            self.quick_error.set_text("Type it like me@192.168.1.10 or me@box.example.com:2222")

    def edit_file(self):
        os.makedirs(hosts.SSH_DIR, mode=0o700, exist_ok=True)
        if not os.path.exists(hosts.SSH_CONFIG):
            core.write_atomic(hosts.SSH_CONFIG, TEMPLATE, 0o600)
        core.spawn("mousepad", hosts.SSH_CONFIG)

    # ---- editor ----------------------------------------------------------
    def back(self):
        self.stack.set_visible_child_name("list")
        self.reload()
        self.probe()

    def show_form(self, host):
        self.editing = host["name"] if host else None
        self.editable = host is None or host["editable"]
        ui.clear(self.form_holder)
        p = ui.Page(760)

        head = ui.hbox(8)
        head.pack_start(ui.button(None, self.back, "flat", "round", icon_name="back", tip="Back"),
                        False, False, 0)
        head.pack_start(ui.label(host["name"] if host else "Add host", "title", ellipsize=True),
                        True, True, 0)
        head.pack_end(ui.button("Save", self.save_and_back, "primary"), False, False, 0)
        p.box.pack_start(head, False, False, 0)
        self.error = ui.label("", "error", wrap=True)
        p.box.pack_start(self.error, False, False, 4)

        p.section("Machine")
        self.kind, self.peer_row = "ssh", None
        if not host:
            p.row("Type", ui.combo([("ssh", "SSH (terminal)"), ("RDP", "Remote desktop (RDP)"),
                                    ("VNC", "VNC")], "ssh", self.kind_changed))
            # filled in once "tailscale status" answers; stays hidden without Tailscale
            self.peers = []
            self.peer_combo = ui.combo([], "", self.pick_peer)
            self.peer_row = p.row("From Tailscale", self.peer_combo, "Fills in the name and address")
            self.peer_row.set_no_show_all(True)
            ui.background(hosts.tailscale_peers, self.got_peers)
        self.fields = {}
        values = host or {}
        for key, title, hint, value in (
            ("name", "Name", "nas", values.get("name", "")),
            ("hostname", "Address", "192.168.1.10", values.get("host", "")),
            ("user", "User", "same as here", values.get("user", "")),
            ("port", "Port", "22", values.get("port", "")),
        ):
            e = Gtk.Entry(text=value, placeholder_text=hint)
            e.set_width_chars(16)
            e.set_sensitive(self.editable)
            if key == "port":
                e.set_input_purpose(Gtk.InputPurpose.DIGITS)
            self.fields[key] = e
            p.row(title, e)
        if not self.editable:
            p.note("This entry shares its line or lives in an included file, so edit it as text. "
                   "The options below still apply.")

        start = len(p.box.get_children())
        p.section("Connection")
        opts = hosts.options(values.get("name", ""))
        self.options = {}
        for key, title, sub in (
            ("tmux", "Resume where I left off", "Opens the same tmux session each time (needs tmux there)"),
            ("reconnect", "Reconnect automatically", "After sleep or a dropped network"),
            ("mosh", "Use mosh", "Survives sleep and Wi-Fi changes (needs mosh there)"),
        ):
            s = Gtk.Switch(active=opts[key])
            self.options[key] = s
            p.row(title, s, sub)

        p.section("SSH key")
        self.host = values
        self.key_combo = ui.combo([], "")
        self.fill_key_choices(hosts.key_choice(values))
        self.key_combo.set_sensitive(self.editable)
        p.row("Key", self.key_combo, "Log in without typing the machine's password")
        p.row("YubiKey or other security key", ui.button("Set up", lambda: core.spawn("termos-settings", "keys")),
              "The key can't be copied, and logging in takes a touch")
        if not os.path.exists(os.path.join(hosts.SSH_DIR, "id_ed25519")):
            p.row("No key yet?", ui.button("Create key", self.create_key),
                  "Asks for a passphrase, which protects the key if the device is lost")
        p.row("Put my key on this machine", ui.button("Copy key", self.copy_key_to_host),
              "Saves, then asks for that machine's password once")
        p.row("My public key", ui.button("Copy text", self.copy_public_key),
              "To paste into a server or website")

        self.ssh_only = p.box.get_children()[start:]

        if host and self.editable:
            p.section("Remove")
            p.row("Delete this host", ui.button("Delete", self.delete, "danger"))

        self.form_holder.pack_start(p.widget, True, True, 0)
        self.form_holder.show_all()
        self.stack.set_visible_child_name("form")
        if not host:
            self.fields["name"].grab_focus()

    def kind_changed(self, kind):
        self.kind = kind
        for w in self.ssh_only:
            w.set_visible(kind == "ssh")
        self.fields["port"].set_placeholder_text({"RDP": "3389", "VNC": "5900"}.get(kind, "22"))
        self.fields["user"].set_placeholder_text("same as here" if kind == "ssh" else "")

    def got_peers(self, peers):
        if not self.alive or not peers or self.peer_row is None:
            return
        self.peers = peers
        self.peer_combo.remove_all()
        self.peer_combo.append("", "Choose a machine…")
        for i, peer in enumerate(peers):
            self.peer_combo.append(str(i), peer["name"] + ("" if peer["online"] else " (offline)"))
        self.peer_combo.set_active_id("")
        self.peer_row.set_no_show_all(False)
        self.peer_row.show_all()

    def pick_peer(self, index):
        if not index:
            return
        peer = self.peers[int(index)]
        name = self.fields["name"]
        if not name.get_text().strip() or name.get_text() in (p["name"] for p in self.peers):
            name.set_text(peer["name"])
        self.fields["hostname"].set_text(peer["host"])

    def save(self):
        name = self.fields["name"].get_text().strip()
        if self.kind != "ssh":
            f = {k: e.get_text().strip() for k, e in self.fields.items()}
            problem = hosts.save_remote(name, self.kind, f["hostname"], f["port"], f["user"])
            self.error.set_text(problem or "")
            return problem is None
        if self.editable:
            values = {k: e.get_text().strip() for k, e in self.fields.items() if k != "name"}
            values.update(hosts.key_fields(self.host, self.key_combo.get_active_id() or ""))
            problem = hosts.save_host(self.editing, name, values)
            if problem:
                self.error.set_text(problem)
                return False
            self.editing = name
            self.host = next((h for h in hosts.ssh_hosts() if h["name"] == name), {})
        hosts.set_meta(name, **{k: s.get_active() for k, s in self.options.items()})
        self.error.set_text("")
        return True

    def save_and_back(self):
        if self.save():
            if self.kind != "ssh":
                ui.message(self, "Added to the home screen",
                           "Remmina asks for the password the first time you connect.")
            self.back()

    def delete(self):
        if ui.confirm(self, f"Delete {self.editing}?",
                      "It is removed from ~/.ssh/config. A backup is kept beside it.",
                      "Delete", danger=True):
            hosts.delete_host(self.editing)
            self.back()

    def create_key(self):
        os.makedirs(hosts.SSH_DIR, 0o700, exist_ok=True)
        in_terminal("Create SSH key",
                    'echo "Choose a passphrase for the new key."; ssh-keygen -t ed25519 -f "$1" -C "$2"',
                    os.path.join(hosts.SSH_DIR, "id_ed25519"),
                    f"{os.environ.get('USER', 'user')}@{core.hostname()}")

    def selected_public_key(self):
        chosen = self.key_combo.get_active_id()
        options = ([os.path.expanduser(chosen)] if chosen
                   else [os.path.join(hosts.SSH_DIR, n) for n in ("id_ed25519", "id_ed25519_sk", "id_ecdsa_sk")])
        if not chosen:
            options += [os.path.expanduser(k) for k in key_files()]
        for path in options:
            if os.path.exists(path + ".pub"):
                return path + ".pub"
        return None

    def copy_key_to_host(self):
        chosen = self.key_combo.get_active_id()
        if chosen in (hosts.PIV, hosts.OPENPGP):
            if self.save():
                in_terminal("Copy card key", COPY_CARD, chosen, self.editing, seckeys.PIV_MODULE)
            return
        pub = self.selected_public_key()
        if not pub:
            self.error.set_text("Create a key first.")
            return
        if self.save():
            in_terminal("Copy SSH key", 'ssh-copy-id -i "$1" -- "$2"', pub, self.editing)

    def copy_public_key(self):
        chosen = self.key_combo.get_active_id()
        if chosen in (hosts.PIV, hosts.OPENPGP):
            in_terminal("Card public key", SHOW_CARD, chosen, seckeys.PIV_MODULE)
            return
        pub = self.selected_public_key()
        if not pub:
            self.error.set_text("Create a key first.")
            return
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(core.slurp(pub), -1)
        ui.message(self, "Public key copied.")


if __name__ == "__main__":
    sys.exit(ui.main("SshHosts", Window, "termos-ssh"))
