#!/bin/bash
# termOS: apply user settings from ~/.config/termos/settings.conf
#   termos-apply-settings [all|theme|wallpaper|windows|keyboard|touchpad]
# Run at login (labwc autostart) and by termos-settings.
conf="$HOME/.config/termos/settings.conf"
WALLPAPER=/usr/share/backgrounds/termos/default.png
WALLPAPER_COLOR=""
MAXIMIZE=1
KEYBOARD_LAYOUT=""
TAP_TO_CLICK=1
NATURAL_SCROLL=0
DISABLE_WHILE_TYPING=1
POINTER_SPEED=0.0
[ -f "$conf" ] && . "$conf"
rc="$HOME/.config/labwc/rc.xml"
envf="$HOME/.config/labwc/environment"
reconf=0

theme() {
    # On Wayland GTK reads these from gsettings, not from settings.ini
    command -v gsettings >/dev/null || return 0
    local k=org.gnome.desktop.interface
    gsettings set $k gtk-theme adw-gtk3-dark
    gsettings set $k icon-theme Papirus-Dark
    gsettings set $k color-scheme prefer-dark
    gsettings set $k font-name 'Adwaita Sans 11'
}

wallpaper() {
    pkill -u "$(id -u)" -x swaybg
    if [ -n "$WALLPAPER_COLOR" ]; then
        setsid -f swaybg -c "$WALLPAPER_COLOR" >/dev/null 2>&1
    elif [ -f "$WALLPAPER" ]; then
        setsid -f swaybg -i "$WALLPAPER" -m fill -c '#1e1e2e' >/dev/null 2>&1
    else
        setsid -f swaybg -c '#1e1e2e' >/dev/null 2>&1
    fi
}

windows() {
    # The rule line in rc.xml carries a termos-maximize marker; switch it
    # between matching every normal window ("*") and matching nothing.
    [ -f "$rc" ] || return 0
    local want='*'; [ "$MAXIMIZE" = 1 ] || want='termos-maximize-off'
    if ! grep -q "identifier=\"$want\" type=\"normal\".*termos-maximize" "$rc"; then
        sed -i "/termos-maximize/s/identifier=\"[^\"]*\"/identifier=\"$want\"/" "$rc"
        reconf=1
    fi
}

keyboard() {
    [ -n "$KEYBOARD_LAYOUT" ] || return 0
    mkdir -p "${envf%/*}"; touch "$envf"
    if ! grep -qx "XKB_DEFAULT_LAYOUT=$KEYBOARD_LAYOUT" "$envf"; then
        sed -i '/^XKB_DEFAULT_LAYOUT=/d' "$envf"
        echo "XKB_DEFAULT_LAYOUT=$KEYBOARD_LAYOUT" >> "$envf"
        reconf=1
    fi
}

touchpad() {
    # Update touchpad libinput tags in rc.xml (inserting new tags on older installs).
    [ -f "$rc" ] || return 0
    local tap=no nat=no dwt=no spd=0.0
    [ "$TAP_TO_CLICK" = 1 ] && tap=yes
    [ "$NATURAL_SCROLL" = 1 ] && nat=yes
    [ "$DISABLE_WHILE_TYPING" = 1 ] && dwt=yes
    [[ $POINTER_SPEED =~ ^-?[0-9]+(\.[0-9]+)?$ ]] && spd=$POINTER_SPEED
    if python3 -I - "$rc" "$tap" "$nat" "$dwt" "$spd" <<'PY'
import re, sys
path, tap, nat, dwt, spd = sys.argv[1:6]
with open(path, encoding="utf-8") as f:
    text = f.read()
m = re.search(r'(<device\s+category="touchpad"[^>]*>)(.*?)(</device>)', text, re.S)
if not m:
    sys.exit(2)
body = m.group(2)
for tag, val in (("tap", tap), ("naturalScroll", nat), ("disableWhileTyping", dwt), ("pointerSpeed", spd)):
    pat = rf"<{tag}>[^<]*</{tag}>"
    if re.search(pat, body):
        body = re.sub(pat, f"<{tag}>{val}</{tag}>", body, count=1)
    else:
        body = body.rstrip() + f"\n      <{tag}>{val}</{tag}>\n    "
new = text[:m.start(2)] + body + text[m.end(2):]
if new == text:
    sys.exit(2)
with open(path, "w", encoding="utf-8") as f:
    f.write(new)
PY
    then
        reconf=1
    fi
}

case "${1:-all}" in
    theme) theme ;;
    all) theme; wallpaper; windows; keyboard; touchpad ;;
    touchpad) touchpad ;;
    wallpaper) wallpaper ;;
    windows) windows ;;
    keyboard) keyboard ;;
esac
if [ "$reconf" = 1 ] && [ -n "$LABWC_PID" ]; then labwc --reconfigure; fi
exit 0
