#!/usr/bin/env python3
"""termOS Settings - a touch-friendly settings app (GTK3).

  termos-settings [display|power|lock|keys|wifi|network|sound|wallpaper|keyboard|system]
"""
import glob
import os
import re
import shutil
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "termos"))
from termosui import bluetooth, core, keyspage, netinfo, screens, ui, widgets  # noqa: E402

import gi  # noqa: E402

gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk  # noqa: E402
from termosui.screenmap import ScreenMap  # noqa: E402

WALLPAPER_DIRS = ["/usr/share/backgrounds/termos", os.path.join(core.HOME, "Pictures", "Wallpapers")]
DEFAULT_WALLPAPER = "/usr/share/backgrounds/termos/default.png"
LAYOUTS = [
    ("us", "English (US)"), ("gb", "English (UK)"), ("de", "German"), ("fr", "French"),
    ("es", "Spanish"), ("it", "Italian"), ("pt", "Portuguese"), ("br", "Portuguese (Brazil)"),
    ("ca", "French (Canada)"), ("ch", "Swiss"), ("be", "Belgian"), ("nl", "Dutch"),
    ("se", "Swedish"), ("no", "Norwegian"), ("dk", "Danish"), ("fi", "Finnish"), ("pl", "Polish"),
    ("cz", "Czech"), ("hu", "Hungarian"), ("ru", "Russian"), ("ua", "Ukrainian"), ("tr", "Turkish"),
    ("jp", "Japanese"), ("latam", "Spanish (Latin America)"),
]
PAGES = [
    ("display", "monitor", "Display"), ("power", "battery", "Power"), ("lock", "lock", "Lock screen"),
    ("keys", "key", "Security keys"),
    ("wifi", "wifi", "Wi-Fi"), ("network", "lan", "Network"), ("sound", "volume-high", "Sound"),
    ("wallpaper", "image", "Wallpaper"), ("keyboard", "keyboard", "Keyboard"),
    ("system", "info", "System"),
]
NARROW = 700


class Settings(Gtk.ApplicationWindow):
    def __init__(self):
        super().__init__(title="Settings")
        self.set_default_size(960, 640)
        self.set_icon_name("preferences-system")
        self.narrow = None
        self.current = None
        self.nav_labels = []
        self.rows = {}

        self.nav = ui.classes(Gtk.ListBox(), "nav")
        for key, glyph, title in PAGES:
            row = Gtk.ListBoxRow()
            row.key = key
            line = ui.hbox(14)
            mark = ui.icon(glyph)
            mark.set_size_request(28, -1)
            line.pack_start(mark, False, False, 0)
            text = ui.label(title)
            text.set_no_show_all(True)
            text.show()
            self.nav_labels.append(text)
            line.pack_start(text, False, False, 0)
            row.add(line)
            row.get_accessible().set_name(title)
            self.nav.add(row)
            self.rows[key] = row
        self.nav.connect("row-selected", self.selected)
        side = Gtk.ScrolledWindow()
        side.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        side.add(self.nav)
        ui.classes(side, "nav")

        right = ui.vbox(0)
        self.heading = ui.label("", "title", ellipsize=True)
        self.heading.set_margin_start(20)
        self.heading.set_margin_top(14)
        right.pack_start(self.heading, False, False, 0)
        self.holder = ui.vbox(0)
        right.pack_start(self.holder, True, True, 0)
        body = ui.hbox(0)
        body.pack_start(side, False, False, 0)
        body.pack_start(right, True, True, 0)
        self.add(body)
        self.connect("size-allocate", self.resized)
        self.nav.select_row(self.rows["display"])

    def resized(self, _w, alloc):
        narrow = alloc.width < NARROW
        if narrow != self.narrow:
            self.narrow = narrow
            # not while allocating
            GLib.idle_add(self.apply_width)

    def apply_width(self):
        for text in self.nav_labels:
            text.set_visible(not self.narrow)
        return False

    def open_arg(self, page, *_rest):
        if page in self.rows:
            self.nav.select_row(self.rows[page])

    def selected(self, _list, row):
        if not row:
            return
        self.current = row.key
        self.rebuild()

    def rebuild(self):
        # pages are built when shown, so they never show stale values
        ui.clear(self.holder)
        self.heading.set_text(next(t for k, _g, t in PAGES if k == self.current))
        p = ui.Page()
        getattr(self, f"{self.current}_page")(p)
        self.holder.pack_start(p.widget, True, True, 0)
        self.holder.show_all()

    def failed(self, what, err):
        ui.message(self, f"Couldn't change {what}.", err)

    def setting_switch(self, p, key, default, title, sub, after=None):
        def changed(on):
            core.write_conf(key, "1" if on else "0")
            if after:
                after()
        p.row(title, ui.switch(core.setting_on(key, default), changed), sub)

    # ---- Display ---------------------------------------------------------
    def display_page(self, p):
        level = core.get_brightness()
        if level is not None:
            p.section("Brightness")
            p.row("Brightness", ui.slider(5, 100, level,
                                          lambda v: ui.background(lambda: core.set_brightness(v)), 170))
        self.screens_ui(p)

        dconf = core.read_conf(core.DISPLAY_CONF)
        if dconf.get("PANEL"):
            p.section("Rotation")
            auto = ui.switch(dconf.get("AUTO", "1") == "1",
                             lambda on: core.spawn("termos-rotate", "auto" if on else "lock"))
            p.row("Auto-rotate", auto, "Follow the tablet's orientation sensor")

            def rotate():
                auto.set_active(False)
                core.spawn("termos-rotate", "cw")
            p.row("Rotate screen", ui.button("Rotate 90°", rotate), "Turns auto-rotate off")

            def set_flip(on):
                core.write_conf("SENSOR_OFFSET", "180" if on else "0", core.DISPLAY_CONF)
                if auto.get_active():
                    core.run("termos-rotate", "lock")
                    core.spawn("termos-rotate", "auto")
            p.row("Sensor mounted upside down", ui.switch(dconf.get("SENSOR_OFFSET", "0") == "180", set_flip),
                  "A fix for tablets whose orientation sensor reads the wrong way round")

        p.section("Desktop")
        self.setting_switch(p, "MAXIMIZE", True, "Open apps full-screen",
                            "Apps fill the screen and shrink when the on-screen keyboard appears",
                            lambda: core.spawn("termos-apply-settings", "windows"))
        self.setting_switch(p, "HOME_SCREEN", True, "Show machines on the home screen",
                            "The SSH and remote desktop machines you added",
                            lambda: core.spawn("termos-show", "reload"))

    def confirm_keep(self):
        """Ask to keep a new display setting; revert automatically after 15 s."""
        dlg, area = ui.dialog(self, "Keep these display settings?")
        count = ui.label("", "sub")
        area.pack_start(count, False, False, 0)
        line = ui.hbox(8)
        line.set_homogeneous(True)
        line.add(ui.button("Revert", lambda: dlg.response(Gtk.ResponseType.CANCEL)))
        line.add(ui.button("Keep", lambda: dlg.response(Gtk.ResponseType.OK), "primary"))
        area.pack_start(line, False, False, 6)
        left = {"n": 15, "tid": 0}

        def tick():
            left["n"] -= 1
            if left["n"] <= 0:
                left["tid"] = 0
                dlg.response(Gtk.ResponseType.CANCEL)
                return False
            count.set_text(f"Reverting in {left['n']} seconds.")
            return True
        count.set_text("Reverting in 15 seconds.")
        left["tid"] = GLib.timeout_add(1000, tick)
        dlg.show_all()
        resp = dlg.run()
        if left["tid"]:
            GLib.source_remove(left["tid"])
        dlg.destroy()
        return resp == Gtk.ResponseType.OK

    @staticmethod
    def screen_title(out):
        if screens.is_builtin(out):
            return "Built-in screen"
        return " ".join(x for x in (out.get("make"), out.get("model"))
                        if x and x.lower() != "unknown") or "Screen"

    def arrangement_ui(self, p, outs):
        state = {"main": screens.main_screen(outs, screens.read_layout()[0])}

        def current():
            items = []
            for o in screens.connected():
                pos = o.get("position") or {}
                items.append((o["name"], self.screen_title(o).replace(" screen", ""),
                              pos.get("x", 0), pos.get("y", 0), *screens.logical_size(o)))
            return items

        def rearrange(main, rects):
            screens.save_layout(main, screens.sides_from(rects, main))
            r = core.run("termos-outputs", "apply")
            if r.returncode:
                self.failed("the screen arrangement", r.stderr.strip())
            state["main"] = main
            smap.set_screens(current(), main)

        def on_main(new):
            if new and new != state["main"]:
                rearrange(new, {n: (x, y, w, h) for n, _l, x, y, w, h in current()})

        p.section("Arrangement")
        smap = ScreenMap(current(), state["main"], lambda rects: rearrange(state["main"], rects))
        p.add(smap)
        p.note("Drag a screen to where it sits on your desk.")
        p.row("Main screen", ui.combo([(o["name"], f"{self.screen_title(o)} ({o['name']})") for o in outs],
                                      state["main"], on_main),
              "New apps open here")

    def screens_ui(self, p):
        outs = screens.connected()
        saved = screens.read_saved()
        if len(outs) > 1:
            self.arrangement_ui(p, outs)
        for out in outs:
            name = out.get("name", "?")
            title = self.screen_title(out)
            p.section(f"{title} ({name})")
            self.screen_rows(p, out, name, saved.get(name, ("auto", "auto")))
        if not outs:
            p.section("Screens")
            p.note("Couldn't read screen information.")

    def screen_rows(self, p, out, name, saved):
        now = {"mode": screens.current_mode(out), "scale": float(out.get("scale", 1)), "busy": False}

        modes, seen, preferred = [], set(), None
        for m in out.get("modes", []):
            ms = screens.mode_name(m)
            if ms in seen:
                continue
            seen.add(ms)
            modes.append((m, ms))
            if m.get("preferred"):
                preferred = ms
        modes.sort(key=lambda t: (t[0]["width"] * t[0]["height"], t[0]["refresh"]), reverse=True)
        if modes:
            options = []
            for m, ms in modes:
                text = f"{m['width']} × {m['height']}"
                if m["refresh"] >= 1:
                    text += f", {m['refresh']:.0f} Hz"
                options.append((ms, text + (" ★" if ms == preferred else "")))

            def on_mode(new):
                if now["busy"] or not new or new == now["mode"]:
                    return
                r = core.run("wlr-randr", "--output", name, "--mode", new)
                if r.returncode == 0 and self.confirm_keep():
                    now["mode"] = new
                    screens.save(name, mode="auto" if new == preferred else new)
                    return
                if r.returncode:
                    self.failed("the resolution", r.stderr.strip())
                elif now["mode"]:
                    core.run("wlr-randr", "--output", name, "--mode", now["mode"])
                now["busy"] = True
                mode_combo.set_active_id(now["mode"])
                now["busy"] = False
            mode_combo = ui.combo(options, now["mode"], on_mode)
            p.row("Resolution", mode_combo, "★ is the screen's own, sharpest resolution")

        auto = screens.auto_scale(out)
        options = [("auto", f"Automatic ({round(auto * 100)} %)")]
        options += [(s, f"{round(float(s) * 100)} %") for s in screens.SCALES]
        chosen = saved[1]
        if chosen not in dict(options):
            options.append((chosen, chosen))
        state = {"choice": chosen}

        def on_scale(new):
            if now["busy"] or not new or new == state["choice"]:
                return
            value = auto if new == "auto" else float(new)
            same = abs(value - now["scale"]) < 0.01
            r = core.run("wlr-randr", "--output", name, "--scale", f"{value:g}")
            if r.returncode == 0 and (same or self.confirm_keep()):
                now["scale"], state["choice"] = value, new
                screens.save(name, scale=new)
                return
            if r.returncode:
                self.failed("the scale", r.stderr.strip())
            else:
                core.run("wlr-randr", "--output", name, "--scale", f"{now['scale']:g}")
            now["busy"] = True
            scale_combo.set_active_id(state["choice"])
            now["busy"] = False
        scale_combo = ui.combo(options, chosen, on_scale)
        p.row("Scale", scale_combo, "Makes text, buttons and windows bigger or smaller")

    # ---- Power -----------------------------------------------------------
    def power_page(self, p):
        bat = core.battery()
        if bat:
            p.section("Battery")
            p.row("Charge", ui.label(f"{bat['percent']} %  ·  {bat['status']}", "row-label"))
            if bat["health"] is not None:
                p.row("Battery health", ui.label(f"{bat['health']} %", "row-label"),
                      "How much of the original capacity is left")

        pconf = core.read_conf(core.POWER_CONF)
        profile = pconf.get("PROFILE", "balanced")
        p.section("Power mode")
        state = {"profile": profile, "busy": False}
        radios = {}

        def set_mode(btn, key):
            if state["busy"] or not btn.get_active() or key == state["profile"]:
                return
            ok, err = core.root_helper("power", "set", key)
            if ok:
                state["profile"] = key
                return
            state["busy"] = True
            radios[state["profile"]].set_active(True)
            state["busy"] = False
            self.failed("the power mode", err)
        group = None
        for key, title, desc in (
            ("power-saver", "Battery saver",
             "Longest battery life. No turbo, lower graphics clock, maximum Wi-Fi and PCIe power "
             "saving. Apps feel slower."),
            ("balanced", "Balanced (recommended)",
             "Full speed in short bursts when needed, power saving the rest of the time."),
            ("performance", "Performance",
             "Always full speed, power saving off. Uses the battery fastest and runs warmer."),
        ):
            rb = Gtk.RadioButton.new_from_widget(group)
            group = group or rb
            words = ui.vbox(2)
            words.set_margin_start(8)
            words.pack_start(ui.label(title, "row-label", wrap=True), False, False, 0)
            words.pack_start(ui.label(desc, "sub", wrap=True), False, False, 0)
            rb.add(words)
            rb.get_accessible().set_name(title)
            rb.set_active(key == profile)
            radios[key] = rb
            p.add(rb)
        for key, rb in radios.items():
            rb.connect("toggled", set_mode, key)
        if pconf.get("ACTIVE", profile) != profile:
            p.note("Battery saver is on right now because the battery is low.", "sub", "warn")

        st = core.read_conf()
        if bat:
            p.section("Automatic battery saver")
            self.setting_switch(p, "AUTO_SAVER", True, "Switch on when the battery is low",
                                "Switches back when plugged in")
            levels = [(x, f"{x} %") for x in ("10", "15", "20", "30", "50")]
            at = st.get("SAVER_AT", "20")
            p.row("Switch on below", ui.combo(levels, at if at in dict(levels) else "20",
                                              lambda v: core.write_conf("SAVER_AT", v)))

        p.section("When not in use")

        def idle_row(title, key, default, choices, sub=None):
            ids = [str(secs) for secs, _t in choices]
            now = st.get(key, str(default))

            def changed(value):
                core.write_conf(key, value)
                core.spawn("termos-idle", "restart")
            p.row(title, ui.combo(choices, now if now in ids else default, changed), sub)
        never = (0, "Never")
        mins = lambda *m: [(x * 60, f"{x} min") for x in m]  # noqa: E731
        idle_row("Dim screen after", "IDLE_DIM", 120, [never, (30, "30 s")] + mins(1, 2, 5, 10))
        idle_row("Turn screen off after", "IDLE_OFF", 300, [never] + mins(1, 2, 5, 10, 30))
        if bat:
            idle_row("Sleep on battery after", "IDLE_SLEEP_BAT", 900, [never] + mins(5, 10, 15, 30, 60),
                     "SSH reconnects after sleep; mosh and tmux keep the session")
        idle_row("Sleep when plugged in after", "IDLE_SLEEP_AC", 0, [never] + mins(15, 30, 60, 120))
        p.note("Video playback and Keep awake in Quick Settings keep the screen on.")

        p.section("Power button")
        key_now = "suspend"
        m = re.search(r"^HandlePowerKey=(\w+)", core.slurp("/etc/systemd/logind.conf.d/termos.conf"), re.M)
        if m:
            key_now = m.group(1)
        pk = {"value": key_now, "busy": False}

        def set_pk(value):
            if pk["busy"] or value == pk["value"]:
                return
            ok, err = core.root_helper("powerkey", value)
            if ok:
                pk["value"] = value
                return
            pk["busy"] = True
            pk_combo.set_active_id(pk["value"])
            pk["busy"] = False
            self.failed("the power button", err)
        pk_combo = ui.combo([("suspend", "Sleep"), ("poweroff", "Shut down"), ("ignore", "Do nothing")],
                            key_now, set_pk)
        p.row("Short press", pk_combo, "Holding the button always shuts down")

    # ---- Lock screen -----------------------------------------------------
    def lock_page(self, p):
        p.section("When to lock")
        p.row("At start-up and after sleep", ui.label("Always", "row-label"),
              "Your PIN is needed before the desktop appears")
        self.setting_switch(p, "LOCK_SCREEN_OFF", True, "When the screen turns off",
                            "Also lock when the screen goes dark after inactivity")
        p.row("Lock now", ui.button("Lock", lambda: core.spawn("termos-lock-now"), icon_name="lock"),
              "Or press Super+L")
        p.section("Change PIN")
        p.add(widgets.PinChanger())
        p.note("After 5 wrong PINs each try has to wait longer. After 10, only your account "
               "password unlocks the device.")
        p.note("The disk is not encrypted: the PIN stops someone using the device, but not "
               "someone who takes the storage out or boots it from USB.")

    # ---- Security keys ---------------------------------------------------
    def keys_page(self, p):
        keyspage.KeysPage(self, p)

    # ---- Wi-Fi -----------------------------------------------------------
    def wifi_page(self, p):
        p.section()
        p.add(widgets.WifiList())
        p.section("More")
        p.row("Hidden and company networks", ui.button("Open", lambda: core.spawn("nm-connection-editor")),
              "The full network connection editor")

    # ---- Network ---------------------------------------------------------
    def network_page(self, p):
        p.section("This device")
        net = netinfo.status()
        p.row("Connection", ui.label(net["name"] or "Not connected", "row-label", wrap=True))
        for line in core.run("ip", "-4", "-br", "addr").stdout.splitlines():
            parts = line.split()
            if len(parts) > 2 and parts[0] != "lo":
                p.row(f"IP address ({parts[0].split('@')[0]})",
                      ui.label(parts[2].split("/")[0], "row-label"))

        p.section("Remote access to this device")
        enabled = core.run("systemctl", "is-enabled", "sshd.service").stdout.strip() == "enabled"

        def set_ssh(on):
            ok, err = core.root_helper("ssh", "on" if on else "off")
            if not ok:
                self.failed("the SSH server", err)
            return ok
        p.row("SSH server", ui.switch(enabled, set_ssh),
              f"Log in to this device with: ssh {os.environ.get('USER', 'user')}@<IP address>")

        p.section("Bluetooth")
        bt_on = bluetooth.state()
        if bt_on is not None:
            p.row("Bluetooth", ui.switch(bt_on, bluetooth.turn),
                  "Turn off to save battery. Phone passkeys and wireless devices need it on")
            p.row("Bluetooth devices", ui.button("Devices…", lambda: core.spawn("termos-bluetooth")),
                  "Pair keyboards, mice and headphones")
        else:
            p.note("No Bluetooth adapter found.")

        p.section("Private network")
        p.add(widgets.TailscaleControls())

    # ---- Sound -----------------------------------------------------------
    def sound_page(self, p):
        p.section("Output")
        vol = core.get_volume()
        if not vol:
            p.note("No sound output found.")
            return
        p.row("Volume", ui.slider(0, 100, min(vol[0], 100),
                                  lambda v: ui.background(lambda: core.set_volume(v)), 170))
        p.row("Mute", ui.switch(vol[1], lambda on: core.set_muted(on)))

    # ---- Wallpaper -------------------------------------------------------
    def wallpaper_page(self, p):
        st = core.read_conf()
        current = "" if st.get("WALLPAPER_COLOR") else st.get("WALLPAPER") or DEFAULT_WALLPAPER
        p.section("Pictures")
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, column_spacing=10, row_spacing=10)
        flow.set_max_children_per_line(3)
        thumbs = []

        def mark(path):
            for item, btn in thumbs:
                ui.set_class(btn, "primary", item == path)

        def choose(path):
            core.write_conf("WALLPAPER", path)
            core.write_conf("WALLPAPER_COLOR", "")
            core.spawn("termos-apply-settings", "wallpaper")
            mark(path)

        files = []
        for folder in WALLPAPER_DIRS:
            for ext in ("png", "jpg", "jpeg", "webp"):
                files += sorted(glob.glob(os.path.join(folder, f"*.{ext}")))
        for path in files:
            try:
                img = Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 176, 110, True))
            except GLib.Error:
                img = Gtk.Image.new_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)
            btn = Gtk.Button()
            box = ui.vbox(4)
            box.set_border_width(5)
            box.pack_start(img, False, False, 0)
            title = os.path.splitext(os.path.basename(path))[0].replace("-", " ").capitalize()
            name = ui.label(title, xalign=0.5, ellipsize=True)
            name.set_max_width_chars(14)
            box.pack_start(name, False, False, 0)
            btn.add(box)
            btn.connect("clicked", lambda _b, item=path: choose(item))
            thumbs.append((path, btn))
            flow.add(btn)
        mark(current)
        p.add(flow)
        p.note("Put your own images in ~/Pictures/Wallpapers to list them here.")

        def pick_file():
            dlg = Gtk.FileChooserDialog(title="Choose wallpaper", transient_for=self,
                                        action=Gtk.FileChooserAction.OPEN)
            dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Use", Gtk.ResponseType.OK)
            flt = Gtk.FileFilter()
            flt.set_name("Images")
            flt.add_mime_type("image/*")
            dlg.add_filter(flt)
            if dlg.run() == Gtk.ResponseType.OK and dlg.get_filename():
                choose(dlg.get_filename())
            dlg.destroy()
        p.row("Other image", ui.button("Choose…", pick_file))

        p.section("Solid colour")
        rgba = Gdk.RGBA()
        rgba.parse(st.get("WALLPAPER_COLOR") or ui.COLORS["base"])
        cb = Gtk.ColorButton.new_with_rgba(rgba)

        def set_color(c):
            col = c.get_rgba()
            core.write_conf("WALLPAPER_COLOR", "#%02x%02x%02x" % tuple(
                round(x * 255) for x in (col.red, col.green, col.blue)))
            core.spawn("termos-apply-settings", "wallpaper")
            mark(None)
        cb.connect("color-set", set_color)
        p.row("Use a plain colour", cb)

    # ---- Keyboard --------------------------------------------------------
    def keyboard_page(self, p):
        p.section("Hardware keyboard")
        st = core.read_conf()
        cur = st.get("KEYBOARD_LAYOUT") or os.environ.get("XKB_DEFAULT_LAYOUT", "us")
        options = list(LAYOUTS)
        if cur not in dict(options):
            options.append((cur, cur))

        def apply_layout(value):
            core.write_conf("KEYBOARD_LAYOUT", value)
            core.spawn("termos-apply-settings", "keyboard")
        p.row("Layout", ui.combo(options, cur, apply_layout))

        other = Gtk.Entry(placeholder_text="e.g. at")
        other.set_width_chars(8)

        def apply_other():
            value = other.get_text().strip()
            if re.fullmatch(r"[a-z]{2,8}(\([a-z0-9_-]+\))?", value):
                apply_layout(value)
                GLib.idle_add(lambda: (self.rebuild(), False)[1])
            else:
                ui.message(self, "That isn't a layout code.", "Examples: at, is, us(intl)")
        line = ui.hbox(8)
        line.pack_start(other, False, False, 0)
        line.pack_start(ui.button("Use", apply_other), False, False, 0)
        p.row("Another layout", line, "By its layout code")

        p.section("Touchpad")

        def set_scroll(on):
            core.write_conf("NATURAL_SCROLL", "1" if on else "0")
            core.spawn("termos-apply-settings", "touchpad")
        p.row("Content follows your fingers", ui.switch(st.get("NATURAL_SCROLL") == "1", set_scroll),
              "Two-finger scrolling works like on a phone")

        p.section("On-screen keyboard")
        p.row("On-screen keyboard", ui.button("Show / hide", lambda: core.spawn("termos-osk", "toggle")),
              "Also on the panel. Open apps shrink to stay visible above it.")

    # ---- System ----------------------------------------------------------
    def system_page(self, p):
        p.section("Device name")
        host = Gtk.Entry(text=core.hostname())
        host.set_width_chars(8)

        def set_host():
            ok, err = core.root_helper("hostname", host.get_text().strip())
            if ok:
                ui.message(self, "Device name changed.")
            else:
                self.failed("the device name", err)
        line = ui.hbox(8)
        line.pack_start(host, True, True, 0)
        line.pack_start(ui.button("Apply", set_host), False, False, 0)
        p.add(line)

        p.section("Date and time")
        p.add(widgets.TimezonePicker())

        p.section("Software")
        p.row("Update termOS and all apps",
              ui.button("Update…", lambda: core.spawn("termos-updater"), "primary"), "Needs internet")
        if not glob.glob("/usr/share/fonts/noto-cjk/*"):
            p.row("Chinese, Japanese and Korean fonts",
                  ui.button("Install", lambda: core.spawn(
                      "foot", "-T", "Install fonts", "-e", "bash", "-c",
                      "sudo pacman -Syu --needed noto-fonts-cjk; echo; read -rp 'Press Enter to close'")),
                  "Optional, about 300 MB. Also updates the system.")
        p.row("Welcome guide", ui.button("Open", lambda: core.spawn("termos-welcome")))

        p.section("About")
        version = core.slurp("/etc/termos/version")
        info = [("termOS", version)] if version else []
        info.append(("Kernel", os.uname().release))
        cpu = re.search(r"model name\s*:\s*(.*)", core.slurp("/proc/cpuinfo"))
        if cpu:
            info.append(("Processor", re.sub(r"\s+", " ", cpu.group(1))))
        mem = re.search(r"MemTotal:\s*(\d+)", core.slurp("/proc/meminfo"))
        if mem:
            info.append(("Memory", f"{int(mem.group(1)) / 1024 / 1024:.1f} GB"))
        du = shutil.disk_usage("/")
        info.append(("Storage", f"{du.free / 1e9:.1f} GB free of {du.total / 1e9:.1f} GB"))
        for key, value in info:
            p.row(key, ui.label(value, "sub", wrap=True, xalign=1.0))


if __name__ == "__main__":
    sys.exit(ui.main("Settings", Settings, "termos-settings"))
