#!/usr/bin/env python3
"""termOS Settings - a small, touch-friendly settings app (GTK3)."""
import glob
import os
import re
import shlex
import shutil
import socket
import subprocess

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk  # noqa: E402

HOME = os.path.expanduser("~")
CFG = os.path.join(HOME, ".config", "termos")
DISPLAY_CONF = os.path.join(CFG, "display.conf")
SETTINGS_CONF = os.path.join(CFG, "settings.conf")
WALLPAPER_DIRS = ["/usr/share/backgrounds/termos", os.path.join(HOME, "Pictures", "Wallpapers")]
DEFAULT_WALLPAPER = "/usr/share/backgrounds/termos/default.png"
LAYOUTS = ["us", "gb", "de", "fr", "es", "it", "pt", "br", "ca", "ch", "be", "nl",
           "se", "no", "dk", "fi", "pl", "cz", "hu", "ru", "ua", "tr", "jp", "latam"]

CSS = b"""
window, .background { font-size: 15px; }
stacksidebar row { padding: 16px 20px; font-size: 16px; }
.page { padding: 24px; }
.section-title { font-size: 13px; font-weight: bold; opacity: 0.6; margin-top: 18px; }
.row-label { font-size: 16px; }
.row-sub { font-size: 12px; opacity: 0.6; }
button { min-height: 44px; padding: 0 18px; }
switch { min-width: 64px; min-height: 34px; }
scale slider { min-width: 32px; min-height: 32px; }
scale trough { min-height: 10px; }
combobox button, entry { min-height: 44px; }
.thumb { padding: 4px; border-radius: 8px; }
.thumb-selected { background: @theme_selected_bg_color; }
"""


# ----------------------------------------------------------------- helpers
def run(*args):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(args, 1, "", str(e))


def spawn(*args):
    try:
        subprocess.Popen(args, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def read_conf(path):
    vals = {}
    try:
        with open(path) as f:
            for line in f:
                m = re.match(r"^\s*([A-Z_][A-Z0-9_]*)=(.*)$", line)
                if m:
                    try:
                        parts = shlex.split(m.group(2))
                        vals[m.group(1)] = parts[0] if parts else ""
                    except ValueError:
                        vals[m.group(1)] = m.group(2)
    except OSError:
        pass
    return vals


def write_conf(path, key, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        with open(path) as f:
            lines = f.readlines()
    except OSError:
        lines = ["# termOS settings (written by termos-settings)\n"]
    new = f"{key}={shlex.quote(str(value))}\n"
    for i, line in enumerate(lines):
        if re.match(rf"^\s*{key}=", line):
            lines[i] = new
            break
    else:
        lines.append(new)
    with open(path, "w") as f:
        f.writelines(lines)


def root_helper(*args):
    r = run("sudo", "-n", "/usr/local/bin/termos-root-helper", *args)
    return r.returncode == 0, (r.stderr or r.stdout).strip()


# ----------------------------------------------------------------- widgets
def label(text, css=None, xalign=0.0, wrap=False):
    lb = Gtk.Label(label=text, xalign=xalign)
    lb.set_line_wrap(wrap)
    if wrap:
        lb.set_max_width_chars(70)
    if css:
        lb.get_style_context().add_class(css)
    return lb


def section(box, title):
    box.pack_start(label(title.upper(), "section-title"), False, False, 0)


def row(box, title, widget, subtitle=None):
    h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
    v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    v.pack_start(label(title, "row-label"), False, False, 0)
    if subtitle:
        v.pack_start(label(subtitle, "row-sub", wrap=True), False, False, 0)
    h.pack_start(v, True, True, 0)
    widget.set_valign(Gtk.Align.CENTER)
    h.pack_end(widget, False, False, 0)
    box.pack_start(h, False, False, 6)
    return h


def page():
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    box.get_style_context().add_class("page")
    # keep controls in a readable column on wide screens
    box.set_halign(Gtk.Align.CENTER)
    box.set_size_request(720, -1)
    sw = Gtk.ScrolledWindow()
    sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    sw.add(box)
    return sw, box


def slider(lo, hi, value, on_change):
    s = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, 1)
    s.set_value(value)
    s.set_size_request(320, -1)
    s.set_value_pos(Gtk.PositionType.RIGHT)
    s.set_digits(0)
    pending = {"id": 0}

    def fire():
        pending["id"] = 0
        on_change(int(s.get_value()))
        return False

    def changed(_sc):
        # debounce: apply 150 ms after the finger stops moving
        if pending["id"]:
            GLib.source_remove(pending["id"])
        pending["id"] = GLib.timeout_add(150, fire)
    s.connect("value-changed", changed)
    return s


# ----------------------------------------------------------------- app
class Settings(Gtk.Window):
    def __init__(self):
        super().__init__(title="Settings")
        self.set_default_size(900, 640)
        self.set_icon_name("preferences-system")
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        side = Gtk.StackSidebar()
        side.set_stack(self.stack)
        side.set_size_request(200, -1)
        hb = Gtk.Box()
        hb.pack_start(side, False, False, 0)
        hb.pack_start(self.stack, True, True, 0)
        self.add(hb)

        self.display_page()
        self.power_page()
        self.sound_page()
        self.wallpaper_page()
        self.keyboard_page()
        self.network_page()
        self.system_page()

    def notify(self, msg):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True,
                                message_type=Gtk.MessageType.INFO,
                                buttons=Gtk.ButtonsType.OK, text=msg)
        dlg.run()
        dlg.destroy()

    # ---- Display ---------------------------------------------------------
    def display_page(self):
        sw, b = page()
        section(b, "Screen")
        r = run("brightnessctl", "-m")
        try:
            cur = int(r.stdout.strip().split(",")[3].rstrip("%"))
        except (IndexError, ValueError):
            cur = None
        if cur is not None:
            row(b, "Brightness",
                slider(5, 100, cur, lambda v: run("brightnessctl", "-q", "set", f"{v}%")))

        dconf = read_conf(DISPLAY_CONF)
        if dconf.get("PANEL"):
            scales = ["1", "1.25", "1.5", "1.75", "2"]
            combo = Gtk.ComboBoxText()
            for s in scales:
                combo.append(s, f"{int(float(s) * 100)} %")
            combo.set_active_id(dconf.get("SCALE", "1") if dconf.get("SCALE", "1") in scales else "1")

            def set_scale(c):
                write_conf(DISPLAY_CONF, "SCALE", c.get_active_id())
                spawn("termos-rotate", "apply")
            combo.connect("changed", set_scale)
            row(b, "Display size", combo, "Makes everything bigger or smaller")

            section(b, "Rotation")
            auto = Gtk.Switch(active=dconf.get("AUTO", "1") == "1")
            auto.connect("notify::active",
                         lambda s, _p: spawn("termos-rotate", "auto" if s.get_active() else "lock"))
            row(b, "Auto-rotate", auto, "Follow the tablet's orientation sensor")

            rot = Gtk.Button(label="Rotate 90°")

            def do_rotate(_b):
                auto.set_active(False)
                spawn("termos-rotate", "cw")
            rot.connect("clicked", do_rotate)
            row(b, "Rotate screen", rot, "Turns auto-rotate off")

            flip = Gtk.Switch(active=dconf.get("SENSOR_OFFSET", "0") == "180")

            def set_flip(s, _p):
                write_conf(DISPLAY_CONF, "SENSOR_OFFSET", "180" if s.get_active() else "0")
                if auto.get_active():
                    run("termos-rotate", "lock")
                    spawn("termos-rotate", "auto")
            flip.connect("notify::active", set_flip)
            row(b, "Flip auto-rotate", flip, "Turn on if auto-rotate shows the screen upside down")

        section(b, "Windows")
        st = read_conf(SETTINGS_CONF)
        maxi = Gtk.Switch(active=st.get("MAXIMIZE", "1") == "1")

        def set_max(s, _p):
            write_conf(SETTINGS_CONF, "MAXIMIZE", "1" if s.get_active() else "0")
            spawn("termos-apply-settings", "windows")
        maxi.connect("notify::active", set_max)
        row(b, "Open apps full-screen", maxi,
            "Apps fill the screen and shrink when the on-screen keyboard appears")
        self.stack.add_titled(sw, "display", "Display")

    # ---- Power -----------------------------------------------------------
    def power_page(self):
        sw, b = page()
        pconf = read_conf("/etc/termos/power.conf")
        profile = pconf.get("PROFILE", "balanced")
        active = pconf.get("ACTIVE", profile)

        bat = None
        for d in sorted(glob.glob("/sys/class/power_supply/*")):
            try:
                with open(os.path.join(d, "type")) as f:
                    if f.read().strip() == "Battery":
                        bat = d
                        break
            except OSError:
                pass

        def sysread(name, default=""):
            try:
                with open(os.path.join(bat, name)) as f:
                    return f.read().strip()
            except (OSError, TypeError):
                return default

        if bat:
            section(b, "Battery")
            text = f"{sysread('capacity', '?')} %  ·  {sysread('status', '?')}"
            row(b, "Charge", label(text, "row-label", xalign=1.0))
            full = sysread("energy_full") or sysread("charge_full")
            design = sysread("energy_full_design") or sysread("charge_full_design")
            if full and design and int(design) > 0:
                row(b, "Battery health", label(f"{int(full) * 100 // int(design)} % of original capacity",
                                               "row-label", xalign=1.0))

        section(b, "Power mode")
        modes = [("power-saver", "Battery saver",
                  "Longest battery life. CPU stays at base speed (no turbo), lower graphics "
                  "clock, maximum Wi-Fi and PCIe power saving. Apps feel slower."),
                 ("balanced", "Balanced (recommended)",
                  "Full speed in short bursts when needed, power saving the rest of the time."),
                 ("performance", "Performance",
                  "Always full speed, power saving off. Uses the battery fastest and runs warmer.")]
        group = None
        self.mode_buttons = {}

        def set_mode(btn, key):
            if not btn.get_active():
                return
            ok, err = root_helper("power", "set", key)
            if not ok:
                self.notify(f"Could not change power mode:\n{err}")
        for key, title, desc in modes:
            rb = Gtk.RadioButton.new_with_label_from_widget(group, title)
            group = group or rb
            rb.get_child().get_style_context().add_class("row-label")
            rb.set_active(key == profile)
            rb.connect("toggled", set_mode, key)
            self.mode_buttons[key] = rb
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            box.pack_start(rb, False, False, 0)
            d = label(desc, "row-sub", wrap=True)
            d.set_margin_start(30)
            box.pack_start(d, False, False, 0)
            b.pack_start(box, False, False, 6)
        if active != profile:
            b.pack_start(label("Battery saver is on right now because the battery is low.",
                               "row-sub", wrap=True), False, False, 0)

        st = read_conf(SETTINGS_CONF)
        if bat:
            auto = Gtk.Switch(active=st.get("AUTO_SAVER", "1") == "1")
            auto.connect("notify::active", lambda s, _p: write_conf(
                SETTINGS_CONF, "AUTO_SAVER", "1" if s.get_active() else "0"))
            level = Gtk.ComboBoxText()
            for pct in ("10", "15", "20", "30", "50"):
                level.append(pct, f"{pct} %")
            level.set_active_id(st.get("SAVER_AT", "20") if st.get("SAVER_AT", "20") in
                                ("10", "15", "20", "30", "50") else "20")
            level.connect("changed", lambda c: write_conf(SETTINGS_CONF, "SAVER_AT", c.get_active_id()))
            h = Gtk.Box(spacing=8)
            h.pack_start(level, False, False, 0)
            h.pack_start(auto, False, False, 0)
            row(b, "Automatic battery saver", h,
                "Switch to Battery saver below this level; back when plugged in")

        section(b, "When not in use")

        def idle_combo(key, default, choices):
            c = Gtk.ComboBoxText()
            for secs, text in choices:
                c.append(str(secs), text)
            cur = st.get(key, str(default))
            c.set_active_id(cur if cur in [str(x) for x, _t in choices] else str(default))

            def changed(cb):
                write_conf(SETTINGS_CONF, key, cb.get_active_id())
                spawn("termos-idle", "restart")
            c.connect("changed", changed)
            return c
        never = (0, "Never")
        mins = lambda *m: [(x * 60, f"{x} min") for x in m]  # noqa: E731
        row(b, "Dim screen after", idle_combo("IDLE_DIM", 120, [never, (30, "30 s")] + mins(1, 2, 5, 10)))
        row(b, "Turn screen off after", idle_combo("IDLE_OFF", 300, [never] + mins(1, 2, 5, 10, 30)))
        if bat:
            row(b, "Sleep on battery after", idle_combo("IDLE_SLEEP_BAT", 900, [never] + mins(5, 10, 15, 30, 60)),
                "SSH sessions drop during sleep; mosh sessions reconnect")
        row(b, "Sleep when plugged in after",
            idle_combo("IDLE_SLEEP_AC", 0, [never] + mins(15, 30, 60, 120)))
        b.pack_start(label("Video playback and the ☕ panel button keep the screen awake.",
                           "row-sub", wrap=True), False, False, 4)

        section(b, "Power button")
        pk = Gtk.ComboBoxText()
        for k, v in (("suspend", "Sleep"), ("poweroff", "Shut down"), ("ignore", "Do nothing")):
            pk.append(k, v)
        cur = "suspend"
        try:
            with open("/etc/systemd/logind.conf.d/termos.conf") as f:
                m = re.search(r"^HandlePowerKey=(\w+)", f.read(), re.M)
                cur = m.group(1) if m else cur
        except OSError:
            pass
        pk.set_active_id(cur)

        def set_pk(c):
            ok, err = root_helper("powerkey", c.get_active_id())
            if not ok:
                self.notify(f"Could not change power button:\n{err}")
        pk.connect("changed", set_pk)
        row(b, "Short press", pk, "Holding the button always shuts down")
        self.stack.add_titled(sw, "power", "Power")

    # ---- Sound -----------------------------------------------------------
    def sound_page(self):
        sw, b = page()
        section(b, "Output")
        r = run("pactl", "get-sink-volume", "@DEFAULT_SINK@")
        m = re.search(r"(\d+)%", r.stdout)
        vol = int(m.group(1)) if m else 50
        row(b, "Volume", slider(0, 100, min(vol, 100),
                                lambda v: run("pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{v}%")))
        muted = "yes" in run("pactl", "get-sink-mute", "@DEFAULT_SINK@").stdout
        mute = Gtk.Switch(active=muted)
        mute.connect("notify::active", lambda s, _p: run(
            "pactl", "set-sink-mute", "@DEFAULT_SINK@", "1" if s.get_active() else "0"))
        row(b, "Mute", mute)
        self.stack.add_titled(sw, "sound", "Sound")

    # ---- Wallpaper -------------------------------------------------------
    def wallpaper_page(self):
        sw, b = page()
        st = read_conf(SETTINGS_CONF)
        current = "" if st.get("WALLPAPER_COLOR") else st.get("WALLPAPER", DEFAULT_WALLPAPER)
        section(b, "Pictures")
        b.pack_start(label("Put your own images in ~/Pictures/Wallpapers to list them here.",
                           "row-sub"), False, False, 0)
        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_max_children_per_line(4)
        flow.set_row_spacing(12)
        flow.set_column_spacing(12)
        self.thumbs = []

        def choose(path):
            write_conf(SETTINGS_CONF, "WALLPAPER", path)
            write_conf(SETTINGS_CONF, "WALLPAPER_COLOR", "")
            spawn("termos-apply-settings", "wallpaper")
            for p, btn in self.thumbs:
                ctx = btn.get_style_context()
                (ctx.add_class if p == path else ctx.remove_class)("thumb-selected")

        files = []
        for d in WALLPAPER_DIRS:
            for ext in ("png", "jpg", "jpeg", "webp"):
                files += sorted(glob.glob(os.path.join(d, f"*.{ext}")))
        for path in files:
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 240, 150, True)
                img = Gtk.Image.new_from_pixbuf(pb)
            except Exception:
                img = Gtk.Image.new_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)
            btn = Gtk.Button()
            btn.add(img)
            btn.set_relief(Gtk.ReliefStyle.NONE)
            btn.get_style_context().add_class("thumb")
            if path == current:
                btn.get_style_context().add_class("thumb-selected")
            btn.connect("clicked", lambda _b, p=path: choose(p))
            self.thumbs.append((path, btn))
            flow.add(btn)
        b.pack_start(flow, False, False, 6)

        pick = Gtk.Button(label="Choose image…")

        def pick_file(_b):
            dlg = Gtk.FileChooserDialog(title="Choose wallpaper", transient_for=self,
                                        action=Gtk.FileChooserAction.OPEN)
            dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Use", Gtk.ResponseType.OK)
            flt = Gtk.FileFilter()
            flt.set_name("Images")
            flt.add_mime_type("image/*")
            dlg.add_filter(flt)
            if dlg.run() == Gtk.ResponseType.OK:
                choose(dlg.get_filename())
            dlg.destroy()
        pick.connect("clicked", pick_file)
        row(b, "Other image", pick)

        section(b, "Solid colour")
        rgba = Gdk.RGBA()
        rgba.parse(st.get("WALLPAPER_COLOR") or "#1e1e2e")
        cb = Gtk.ColorButton.new_with_rgba(rgba)

        def set_color(c):
            col = c.get_rgba()
            hexcol = "#%02x%02x%02x" % (int(col.red * 255), int(col.green * 255), int(col.blue * 255))
            write_conf(SETTINGS_CONF, "WALLPAPER_COLOR", hexcol)
            spawn("termos-apply-settings", "wallpaper")
            for _p, btn in self.thumbs:
                btn.get_style_context().remove_class("thumb-selected")
        cb.connect("color-set", set_color)
        row(b, "Use a plain colour", cb)
        self.stack.add_titled(sw, "wallpaper", "Wallpaper")

    # ---- Keyboard --------------------------------------------------------
    def keyboard_page(self):
        sw, b = page()
        section(b, "Hardware keyboard")
        st = read_conf(SETTINGS_CONF)
        cur = st.get("KEYBOARD_LAYOUT") or os.environ.get("XKB_DEFAULT_LAYOUT", "us")
        combo = Gtk.ComboBoxText.new_with_entry()
        for lay in LAYOUTS:
            combo.append(lay, lay)
        combo.get_child().set_text(cur)
        combo.get_child().set_width_chars(8)
        apply_btn = Gtk.Button(label="Apply")

        def apply_layout(_b):
            lay = combo.get_child().get_text().strip()
            if not re.fullmatch(r"[a-z]{2,8}(\([a-z0-9_-]+\))?", lay):
                self.notify("That doesn't look like a keyboard layout code (e.g. us, de, gb).")
                return
            write_conf(SETTINGS_CONF, "KEYBOARD_LAYOUT", lay)
            spawn("termos-apply-settings", "keyboard")
        apply_btn.connect("clicked", apply_layout)
        h = Gtk.Box(spacing=8)
        h.pack_start(combo, False, False, 0)
        h.pack_start(apply_btn, False, False, 0)
        row(b, "Layout", h, "Two-letter layout code, e.g. us, gb, de, fr")

        section(b, "On-screen keyboard")
        show = Gtk.Button(label="Show / hide")
        show.connect("clicked", lambda _b: spawn("termos-osk", "toggle"))
        row(b, "On-screen keyboard", show,
            "Also on the ⌨ panel button. Open apps shrink to stay visible above it.")
        self.stack.add_titled(sw, "keyboard", "Keyboard")

    # ---- Network ---------------------------------------------------------
    def network_page(self):
        sw, b = page()
        section(b, "Connections")
        nm = Gtk.Button(label="Open")
        nm.connect("clicked", lambda _b: spawn("nm-connection-editor"))
        row(b, "Wi-Fi & network connections", nm,
            "Or use the network icon in the panel to join Wi-Fi")

        addrs = run("ip", "-4", "-br", "addr").stdout.splitlines()
        addrs = [a.split() for a in addrs if a and not a.startswith("lo ")]
        text = "\n".join(f"{a[0].split('@')[0]}: {a[2].split('/')[0]}" for a in addrs if len(a) > 2) or "not connected"
        row(b, "This device's IP address", label(text, "row-label", xalign=1.0))

        section(b, "Remote access to this device")
        enabled = run("systemctl", "is-enabled", "sshd.service").stdout.strip() == "enabled"
        ssh = Gtk.Switch(active=enabled)
        busy = {"v": False}

        def set_ssh(s, _p):
            if busy["v"]:
                return
            ok, err = root_helper("ssh", "on" if s.get_active() else "off")
            if not ok:
                busy["v"] = True
                s.set_active(not s.get_active())
                busy["v"] = False
                self.notify(f"Could not change SSH server:\n{err}")
        ssh.connect("notify::active", set_ssh)
        row(b, "SSH server", ssh,
            f"Allow logging in to this device with: ssh {os.environ.get('USER', 'user')}@<IP address>")
        section(b, "Bluetooth")
        rf = run("rfkill", "list", "bluetooth").stdout
        if "Bluetooth" in rf or "hci" in rf:
            bt = Gtk.Switch(active="Soft blocked: yes" not in rf)
            bt.connect("notify::active", lambda s, _p: run(
                "rfkill", "unblock" if s.get_active() else "block", "bluetooth"))
            row(b, "Bluetooth", bt, "Turn off to save battery when not using Bluetooth devices")
            btb = Gtk.Button(label="Devices…")
            btb.connect("clicked", lambda _b: spawn("termos-bluetooth"))
            row(b, "Bluetooth devices", btb, "Pair keyboards, mice and headphones")
        else:
            row(b, "Bluetooth", label("No Bluetooth adapter found", "row-sub", xalign=1.0))

        section(b, "Tailscale (private network)")
        ts_on = run("systemctl", "is-enabled", "tailscaled.service").stdout.strip() == "enabled"
        ts_info = label("", "row-sub", xalign=1.0)

        def ts_refresh():
            if not ts_sw.get_active():
                ts_info.set_text("off")
                return
            r = run("tailscale", "status", "--json")
            try:
                import json
                j = json.loads(r.stdout)
                state = j.get("BackendState", "?")
                ips = ", ".join(j.get("Self", {}).get("TailscaleIPs", [])[:1])
                ts_info.set_text(f"{state}{'  ·  ' + ips if ips else ''}")
            except (ValueError, AttributeError):
                ts_info.set_text("starting…")
        ts_sw = Gtk.Switch(active=ts_on)
        busy_ts = {"v": False}

        def set_ts(s, _p):
            if busy_ts["v"]:
                return
            ok, err = root_helper("tailscale", "on" if s.get_active() else "off")
            if not ok:
                busy_ts["v"] = True
                s.set_active(not s.get_active())
                busy_ts["v"] = False
                self.notify(f"Could not change Tailscale:\n{err}")
            ts_refresh()
        ts_sw.connect("notify::active", set_ts)
        row(b, "Tailscale", ts_sw, "Reach your machines from any network without opening ports")
        login = Gtk.Button(label="Sign in…")
        login.connect("clicked", lambda _b: spawn("foot", "-T", "Tailscale sign-in", "-e",
                                                  "termos-tailscale-login"))
        row(b, "Account", login, "Opens the Tailscale sign-in page in the browser")
        row(b, "Status", ts_info)
        ts_refresh()
        self.stack.add_titled(sw, "network", "Network")

    # ---- System ----------------------------------------------------------
    def system_page(self):
        sw, b = page()
        section(b, "Device")
        host = Gtk.Entry(text=socket.gethostname())
        host.set_width_chars(22)
        hbtn = Gtk.Button(label="Apply")

        def set_host(_b):
            ok, err = root_helper("hostname", host.get_text().strip())
            self.notify("Hostname changed." if ok else f"Could not change hostname:\n{err}")
        hbtn.connect("clicked", set_host)
        h = Gtk.Box(spacing=8)
        h.pack_start(host, False, False, 0)
        h.pack_start(hbtn, False, False, 0)
        row(b, "Hostname", h)

        tzs = run("timedatectl", "list-timezones").stdout.split()
        curtz = run("timedatectl", "show", "-p", "Timezone", "--value").stdout.strip()
        tz = Gtk.ComboBoxText.new_with_entry()
        for z in tzs:
            tz.append(z, z)
        tz.get_child().set_text(curtz)
        tz.get_child().set_width_chars(22)
        compl = Gtk.EntryCompletion()
        store = Gtk.ListStore(str)
        for z in tzs:
            store.append([z])
        compl.set_model(store)
        compl.set_text_column(0)
        compl.set_match_func(lambda _c, key, it: key.lower() in store[it][0].lower())
        tz.get_child().set_completion(compl)
        tzbtn = Gtk.Button(label="Apply")

        def set_tz(_b):
            ok, err = root_helper("timezone", tz.get_child().get_text().strip())
            self.notify("Timezone changed." if ok else f"Could not change timezone:\n{err}")
        tzbtn.connect("clicked", set_tz)
        h = Gtk.Box(spacing=8)
        h.pack_start(tz, False, False, 0)
        h.pack_start(tzbtn, False, False, 0)
        row(b, "Timezone", h, "Type part of a city name, e.g. Toronto")

        section(b, "Software")
        upd = Gtk.Button(label="Update now")
        upd.connect("clicked", lambda _b: spawn("foot", "-T", "termOS update", "-e", "termos-update"))
        row(b, "Update termOS and all apps", upd, "Opens a terminal; needs internet")

        section(b, "About")
        info = []
        try:
            with open("/etc/termos/version") as f:
                info.append(("termOS", f.read().strip()))
        except OSError:
            pass
        info.append(("Kernel", os.uname().release))
        try:
            with open("/proc/cpuinfo") as f:
                cpu = re.search(r"model name\s*:\s*(.*)", f.read())
                info.append(("Processor", re.sub(r"\s+", " ", cpu.group(1)) if cpu else "?"))
            with open("/proc/meminfo") as f:
                kb = int(re.search(r"MemTotal:\s*(\d+)", f.read()).group(1))
                info.append(("Memory", f"{kb / 1024 / 1024:.1f} GB"))
        except (OSError, AttributeError):
            pass
        du = shutil.disk_usage("/")
        info.append(("Storage", f"{du.free / 1e9:.1f} GB free of {du.total / 1e9:.1f} GB"))
        for k, v in info:
            row(b, k, label(v, "row-label", xalign=1.0))
        self.stack.add_titled(sw, "system", "System")


def main():
    import sys
    win = Settings()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    if len(sys.argv) > 1 and win.stack.get_child_by_name(sys.argv[1]):
        win.stack.set_visible_child_name(sys.argv[1])
    Gtk.main()


if __name__ == "__main__":
    main()
