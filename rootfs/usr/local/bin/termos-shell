#!/usr/bin/env python3
"""termOS desktop shell. Started by termos-shell-run; control it with termos-show."""
import os
import signal
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "termos"))
from termosui.shell.main import Shell  # noqa: E402

if __name__ == "__main__":
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    sys.exit(Shell().run([]))
