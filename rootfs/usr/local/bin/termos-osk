#!/bin/bash
# termOS on-screen keyboard (squeekboard). Usage: termos-osk [toggle|show|hide|restore]
# Squeekboard is only started the first time it is asked for, so it costs
# nothing when you use the keyboard cover.
# It hides itself whenever another window takes the focus, so the user's choice
# is remembered and termos-shell calls "restore" when the focus moves.
wanted="${XDG_RUNTIME_DIR:-/tmp}/termos-osk-wanted"
uid=$(id -u)
visible() {
    busctl --user get-property sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 Visible 2>/dev/null | awk '{print $2}'
}
running() { pgrep -u "$uid" -r R,S,D -x squeekboard >/dev/null; }

case "${1:-toggle}" in
    show) v=true ;;
    hide) v=false ;;
    restore)
        [ -f "$wanted" ] && running || exit 0
        v=true ;;
    *) [ "$(visible)" = true ] && v=false || v=true ;;
esac
if [ "$v" = true ]; then
    touch "$wanted"
else
    rm -f "$wanted"
    running || exit 0
fi
if ! running; then
    setsid -f squeekboard >/dev/null 2>&1
    for _ in $(seq 50); do [ -n "$(visible)" ] && break; sleep 0.1; done
fi
busctl --user call sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 SetVisible b "$v"
