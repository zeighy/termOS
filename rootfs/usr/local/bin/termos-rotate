#!/bin/bash
# termOS screen rotation helper.
#   termos-rotate cw       rotate 90 degrees clockwise (turns auto-rotate off)
#   termos-rotate auto     follow the accelerometer
#   termos-rotate lock     stop following the accelerometer
#   termos-rotate apply    re-apply the saved rotation
conf="$HOME/.config/termos/display.conf"
pidfile="${XDG_RUNTIME_DIR:-/tmp}/termos-autorotate.pid"
[ -f "$conf" ] || { echo "no $conf yet (run termos-display-setup)"; exit 1; }
. "$conf"
[ -n "$PANEL" ] || exit 0

save() {
    sed -i -e "s/^ROT=.*/ROT=$ROT/" -e "s/^AUTO=.*/AUTO=$AUTO/" "$conf"
}
# Rotating while a finger is still on the screen leaves the touch "stuck"
# (waybar fires on press). Defer manual rotations until the tap is over.
apply_later() {
    setsid -f sh -c 'sleep 0.6; exec "$0" apply' "$0" >/dev/null 2>&1
}
apply() {
    local deg=$(( (BASE + ROT) % 360 )) t
    case $deg in 0) t=normal ;; *) t=$deg ;; esac
    wlr-randr --output "$PANEL" --transform "$t" --scale "${SCALE:-1}"
}
daemon_running() {
    [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}
stop_daemon() {
    daemon_running && kill -TERM -- "-$(cat "$pidfile")" 2>/dev/null
    rm -f "$pidfile"
}

case "${1:-apply}" in
    apply) apply ;;
    cw)
        stop_daemon
        ROT=$(( (ROT + 90) % 360 )); AUTO=0; save; apply_later ;;
    lock)
        stop_daemon; AUTO=0; save ;;
    auto)
        AUTO=1; save; exec "$0" start-daemon ;;
    start-daemon)
        daemon_running || setsid -f "$0" daemon >/dev/null 2>&1 ;;
    daemon)
        echo $$ > "$pidfile"
        command -v monitor-sensor >/dev/null || exit 0
        # iio-sensor-proxy reports orientation relative to the panel's
        # NATIVE orientation, so the sensor gives the final transform
        # directly (BASE is not added). SENSOR_OFFSET=180 flips it if a
        # device's sensor is mounted the other way round.
        monitor-sensor | while read -r line; do
            case $line in
                *"No accelerometer"*) exit 0 ;;
                *normal*)    s=0 ;;
                *left-up*)   s=90 ;;
                *bottom-up*) s=180 ;;
                *right-up*)  s=270 ;;
                *) continue ;;
            esac
            t=$(( (s + ${SENSOR_OFFSET:-0}) % 360 ))
            ROT=$(( (t - BASE + 360) % 360 ))
            save; apply
        done ;;
    *) sed -n '2,7p' "$0"; exit 1 ;;
esac
