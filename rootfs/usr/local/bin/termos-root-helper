#!/bin/bash
# termOS: the few privileged actions the Settings app needs.
# Allowed password-less for the wheel group via /etc/sudoers.d/11-termos-helper,
# so every argument is strictly validated here.
set -euo pipefail
die() { echo "termos-root-helper: $*" >&2; exit 1; }
[[ $EUID -eq 0 ]] || die "must run as root (use sudo)"

case "${1:-}" in
    ssh)
        case "${2:-}" in
            on)     systemctl enable --now sshd.service ;;
            off)    systemctl disable --now sshd.service ;;
            status) systemctl is-enabled sshd.service 2>/dev/null || true ;;
            *) die "usage: ssh on|off|status" ;;
        esac ;;
    hostname)
        h=${2:-}
        [[ $h =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] || die "invalid hostname"
        hostnamectl hostname "$h"
        if grep -q '^127\.0\.1\.1' /etc/hosts; then
            sed -i "s/^127\.0\.1\.1.*/127.0.1.1   $h/" /etc/hosts
        else
            echo "127.0.1.1   $h" >> /etc/hosts
        fi ;;
    timezone)
        tz=${2:-}
        [[ $tz =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$ && -f /usr/share/zoneinfo/$tz ]] || die "invalid timezone"
        timedatectl set-timezone "$tz" ;;
    powerkey)
        case "${2:-}" in suspend|poweroff|ignore) ;; *) die "usage: powerkey suspend|poweroff|ignore" ;; esac
        sed -i "s/^HandlePowerKey=.*/HandlePowerKey=$2/" /etc/systemd/logind.conf.d/termos.conf
        systemctl kill -s HUP systemd-logind.service ;;
    *) die "usage: ssh|hostname|timezone|powerkey ..." ;;
esac
