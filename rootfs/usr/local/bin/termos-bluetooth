#!/usr/bin/env python3
"""termOS Bluetooth.

  termos-bluetooth            open the devices window (turns Bluetooth on)
  termos-bluetooth on|off     switch, and remember it
  termos-bluetooth restore    re-apply the saved choice (login, wake)
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "termos"))
from termosui import bluetooth, core  # noqa: E402


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "devices"
    if cmd in ("on", "off"):
        return 0 if bluetooth.turn(cmd == "on") else 1
    if cmd == "restore":
        bluetooth.restore()
        return 0
    if cmd != "devices":
        print(__doc__, file=sys.stderr)
        return 1
    bluetooth.turn(True)
    # the applet provides the pairing agent for PIN codes
    if core.run("pgrep", "-u", str(os.getuid()), "-f", "blueman-applet").returncode:
        core.spawn("blueman-applet")
    os.execvp("blueman-manager", ["blueman-manager"])


if __name__ == "__main__":
    sys.exit(main())
