# Bigger touch targets
window.titlebar.padding.height: 6
menu.items.padding.x: 16
menu.items.padding.y: 10
menu.overlap.x: 0

# Dark title bars and menus to match the rest of termOS
window.active.title.bg.color: #181825
window.inactive.title.bg.color: #11111b
window.active.label.text.color: #cdd6f4
window.inactive.label.text.color: #7f849c
window.active.button.unpressed.image.color: #cdd6f4
window.inactive.button.unpressed.image.color: #7f849c
window.active.border.color: #313244
window.inactive.border.color: #181825
menu.items.bg.color: #1e1e2e
menu.items.text.color: #cdd6f4
menu.items.active.bg.color: #45475a
menu.items.active.text.color: #ffffff
menu.border.color: #45475a
menu.separator.color: #45475a
osd.bg.color: #1e1e2e
osd.label.text.color: #cdd6f4
osd.border.color: #45475a
