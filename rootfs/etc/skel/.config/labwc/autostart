# make the Wayland session visible to D-Bus/systemd-activated services
# (notifications, on-screen keyboard, portals)
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE LABWC_PID SSH_AUTH_SOCK
# termOS session autostart (runs once when labwc starts; the PIN was entered at the boot gate)
termos-session-guard >/dev/null &
# one after the other: both of these edit rc.xml
( termos-apply-settings; termos-display-setup ) >/dev/null 2>&1 &
termos-shell-run >/dev/null &
termos-idle start >/dev/null 2>&1 &
termos-nightlight restore >/dev/null 2>&1 &
termos-bluetooth restore >/dev/null 2>&1 &
termos-battery-monitor >/dev/null 2>&1 &
