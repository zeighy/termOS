<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu>
  <menu id="root-menu" label="termOS">
    <item label="All apps"><action name="Execute" command="termos-show apps" /></item>
    <item label="Quick settings"><action name="Execute" command="termos-show quick" /></item>
    <item label="Open windows"><action name="Execute" command="termos-show windows" /></item>
    <item label="Show home screen"><action name="Execute" command="termos-show desktop" /></item>
    <separator />
    <item label="Terminal"><action name="Execute" command="foot" /></item>
    <item label="SSH hosts"><action name="Execute" command="termos-ssh" /></item>
    <item label="Browser"><action name="Execute" command="chromium" /></item>
    <item label="Files"><action name="Execute" command="thunar" /></item>
    <item label="Remote desktop"><action name="Execute" command="remmina" /></item>
    <menu id="screenshot-menu" label="Screenshot">
      <item label="Whole screen"><action name="Execute" command="termos-screenshot full" /></item>
      <item label="In 3 seconds"><action name="Execute" command="termos-screenshot delay" /></item>
      <item label="Select an area"><action name="Execute" command="termos-screenshot area" /></item>
    </menu>
    <item label="Settings"><action name="Execute" command="termos-settings" /></item>
    <separator />
    <item label="Lock screen"><action name="Execute" command="termos-lock-now" /></item>
    <item label="Power"><action name="Execute" command="termos-show power" /></item>
    <menu id="restart-menu" label="Restart desktop">
      <!-- a second tap, because it closes every app -->
      <item label="Close apps and restart"><action name="Exit" /></item>
    </menu>
  </menu>
</openbox_menu>
