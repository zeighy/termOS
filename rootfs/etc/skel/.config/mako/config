# termOS notifications - tap to dismiss
font=DejaVu Sans 12
background-color=#1e1e2eee
text-color=#cdd6f4
border-color=#45475a
border-size=2
border-radius=10
padding=14
margin=12
width=380
icon-path=/usr/share/icons/Papirus-Dark
max-icon-size=48
default-timeout=6000
anchor=top-center
on-touch=dismiss

[urgency=critical]
border-color=#f38ba8
default-timeout=0
