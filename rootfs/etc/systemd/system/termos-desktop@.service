[Unit]
Description=termOS desktop for %i (starts at the lock screen)
After=systemd-user-sessions.service plymouth-quit-wait.service getty@tty1.service systemd-logind.service dbus.socket termos-pin.socket
Wants=dbus.socket systemd-logind.service termos-pin.socket
Conflicts=getty@tty1.service
Before=graphical.target
ConditionPathExists=/dev/tty0
StartLimitIntervalSec=0

[Service]
Type=simple
User=%i
PAMName=login
WorkingDirectory=~
ExecStart=/usr/local/bin/termos-session
# the session only ever (re)starts at the lock screen, so restarting is safe
Restart=always
RestartSec=1
TimeoutStopSec=15
# one app killed for using too much memory must not end the whole desktop
OOMPolicy=continue
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user
UtmpIdentifier=tty1
UtmpMode=user
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
