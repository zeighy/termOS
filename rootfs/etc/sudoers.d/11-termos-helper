# termOS: let admins use the Settings app's validated helper without a password
%wheel ALL=(root) NOPASSWD: /usr/local/bin/termos-root-helper
# fallback for termos-pin (normally reached via termos-pin.socket, which does not go
# through sudo/PAM so pam_faillock can never lock the user out of the lock screen)
%wheel ALL=(root) NOPASSWD: /usr/local/bin/termos-pin
